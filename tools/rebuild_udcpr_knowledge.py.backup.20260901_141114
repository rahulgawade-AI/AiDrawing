#!/usr/bin/env python3

"""
UDCPR KNOWLEDGE REBUILD

Pipeline:

    canonical manifest
        +
    canonical source chunks
        |
        v
    PostgreSQL regulations
        |
        +--> rules
        |
        +--> knowledge_cards
        |
        v
    Chroma

IMPORTANT
---------
1. Existing regulations are NOT deleted.
2. Existing tables are NOT modified.
3. Existing rules are backed up.
4. Existing knowledge_cards are backed up.
5. Chroma is backed up before rebuild.
6. Dry-run is default.
7. --apply performs the rebuild.
8. The canonical source is:
       data/regulations/udcpr_source_chunks.json
9. Exactly 329 canonical regulations are expected.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import sys
import uuid
from collections import defaultdict
from datetime import datetime
from pathlib import Path
from typing import Any

from sqlalchemy import text

from townplanning.infrastructure.database.session import SessionLocal
from townplanning.infrastructure.database.models import (
    RegulationModel,
)


# ============================================================
# CONFIG
# ============================================================

DEFAULT_MANIFEST = (
    "data/regulations/udcpr_canonical_manifest.json"
)

DEFAULT_CHUNKS = (
    "data/regulations/udcpr_source_chunks.json"
)

DEFAULT_REPORT = (
    "/tmp/udcpr_knowledge_rebuild.json"
)

EXPECTED_REGULATIONS = 329


# ============================================================
# UTILITIES
# ============================================================

def sha256(value: str) -> str:
    return hashlib.sha256(
        value.encode("utf-8")
    ).hexdigest()


def normalize(value: Any) -> str:
    if value is None:
        return ""

    return (
        str(value)
        .replace("\r\n", "\n")
        .replace("\r", "\n")
        .strip()
    )


def normalize_title(value: Any) -> str:
    return " ".join(
        normalize(value).lower().split()
    )


def normalize_number(value: Any) -> str:
    return (
        normalize(value)
        .replace(" ", "")
    )


def regulation_key(
    number: Any,
    title: Any,
) -> str:

    return (
        normalize_number(number)
        + "|"
        + normalize_title(title)
    )


def load_json(path: str) -> Any:

    with open(
        path,
        "r",
        encoding="utf-8",
    ) as f:
        return json.load(f)


def write_json(
    path: str,
    value: Any,
):

    Path(path).parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    with open(
        path,
        "w",
        encoding="utf-8",
    ) as f:
        json.dump(
            value,
            f,
            indent=2,
            ensure_ascii=False,
            default=str,
        )


# ============================================================
# LOAD SOURCE
# ============================================================

def load_source(
    manifest_path: str,
    chunks_path: str,
):

    manifest = load_json(
        manifest_path
    )

    chunks_data = load_json(
        chunks_path
    )

    if isinstance(manifest, dict):
        manifest_entries = (
            manifest.get("regulations")
            or manifest.get("entries")
            or manifest.get("items")
            or []
        )
    else:
        manifest_entries = manifest

    if isinstance(chunks_data, dict):
        chunks = (
            chunks_data.get("chunks")
            or chunks_data.get("source_chunks")
            or chunks_data.get("items")
            or []
        )
    else:
        chunks = chunks_data

    if not isinstance(
        manifest_entries,
        list,
    ):
        raise RuntimeError(
            "Manifest regulations is not a list."
        )

    if not isinstance(
        chunks,
        list,
    ):
        raise RuntimeError(
            "Source chunks is not a list."
        )

    manifest_by_key = {}

    for entry in manifest_entries:

        key = regulation_key(
            entry.get("number"),
            entry.get("title"),
        )

        if key in manifest_by_key:
            raise RuntimeError(
                f"Duplicate manifest key: {key}"
            )

        manifest_by_key[key] = entry

    chunks_by_key = defaultdict(list)

    for chunk in chunks:

        key = regulation_key(
            chunk.get("number"),
            chunk.get("title"),
        )

        chunks_by_key[key].append(
            chunk
        )

    return (
        manifest_by_key,
        chunks_by_key,
    )


# ============================================================
# SOURCE TEXT
# ============================================================

def chunk_text(
    chunk: dict,
) -> str:

    for field in (
        "text",
        "content",
        "markdown",
        "chunk_text",
    ):

        value = chunk.get(field)

        if isinstance(
            value,
            str,
        ):

            return value

    return ""


def source_tables(
    chunk: dict,
) -> list[dict]:

    for field in (
        "tables",
        "source_tables",
    ):

        value = chunk.get(field)

        if isinstance(
            value,
            list,
        ):

            return value

    return []


# ============================================================
# DATABASE
# ============================================================

def load_regulations(db):

    rows = (
        db.query(
            RegulationModel
        )
        .all()
    )

    by_key = defaultdict(list)

    for row in rows:

        by_key[
            regulation_key(
                row.number,
                row.title,
            )
        ].append(row)

    return by_key


def select_regulations(
    db,
    manifest_by_key,
):

    rows = (
        db.query(
            RegulationModel
        )
        .all()
    )

    by_key = defaultdict(
        list
    )

    for row in rows:

        key = regulation_key(
            row.number,
            row.title,
        )

        by_key[
            key
        ].append(
            row
        )

    selected = {}

    missing = []

    ambiguous = []

    for key, entry in manifest_by_key.items():

        candidates = by_key.get(
            key,
            []
        )

        if len(candidates) == 0:

            missing.append(
                {
                    "key": key,
                    "number":
                        entry.get("number"),
                    "title":
                        entry.get("title"),
                }
            )

            continue

        # ----------------------------------------------------
        # IMPORTANT
        #
        # The existing PostgreSQL regulations table contains
        # historical duplicate rows.
        #
        # We therefore DO NOT require one DB row.
        #
        # The canonical row is selected using the page
        # information from the canonical manifest.
        # ----------------------------------------------------

        expected_pdf_page = (
            entry.get(
                "pdf_page_start"
            )
        )

        expected_printed_page = (
            entry.get(
                "printed_page_start"
            )
        )

        scored = []

        for row in candidates:

            score = 0

            row_page_start = getattr(
                row,
                "page_start",
                None,
            )

            row_page_end = getattr(
                row,
                "page_end",
                None,
            )

            # Printed page is strongest signal.
            if (
                expected_printed_page is not None
                and row_page_start
                == expected_printed_page
            ):

                score += 100

            # PDF page is secondary signal.
            if (
                expected_pdf_page is not None
                and (
                    row_page_start
                    == expected_pdf_page
                    or
                    row_page_end
                    == expected_pdf_page
                )
            ):

                score += 50

            # Earlier page wins if there is no explicit
            # page match.
            try:

                page_value = int(
                    row_page_start
                    or 999999
                )

            except (
                TypeError,
                ValueError,
            ):

                page_value = 999999

            scored.append(
                (
                    score,
                    -page_value,
                    str(row.id),
                    row,
                )
            )

        scored.sort(
            reverse=True
        )

        best = scored[0]

        # ----------------------------------------------------
        # Only report ambiguous if the best two candidates
        # have the same score AND same page.
        #
        # This is exactly the selection logic used by the
        # successful 329-regulation database rebuild.
        # ----------------------------------------------------

        if (
            len(scored) > 1
            and scored[0][0]
            == scored[1][0]
            and scored[0][1]
            == scored[1][1]
        ):

            ambiguous.append(
                {
                    "key": key,
                    "number":
                        entry.get("number"),
                    "title":
                        entry.get("title"),
                    "candidate_ids":
                        [
                            str(x[2])
                            for x in scored
                        ],
                }
            )

            continue

        selected[
            key
        ] = best[3]

    return (
        selected,
        missing,
        ambiguous,
    )

def table_exists(
    db,
    table_name: str,
) -> bool:

    return bool(
        db.execute(
            text(
                """
                SELECT EXISTS (
                    SELECT 1
                    FROM information_schema.tables
                    WHERE table_schema = 'public'
                      AND table_name = :name
                )
                """
            ),
            {
                "name": table_name
            },
        ).scalar_one()
    )


def count_table(
    db,
    table_name: str,
) -> int:

    if not table_exists(
        db,
        table_name,
    ):
        return 0

    return int(
        db.execute(
            text(
                f'''
                SELECT COUNT(*)
                FROM public."{table_name}"
                '''
            )
        ).scalar_one()
    )


# ============================================================
# BACKUP
# ============================================================

def backup_table(
    db,
    table_name: str,
    backup_name: str,
):

    if not table_exists(
        db,
        table_name,
    ):
        return False

    db.execute(
        text(
            f'''
            DROP TABLE IF EXISTS
                public."{backup_name}"
            '''
        )
    )

    db.execute(
        text(
            f'''
            CREATE TABLE public."{backup_name}"
            AS
            SELECT *
            FROM public."{table_name}"
            '''
        )
    )

    return True


# ============================================================
# CREATE RULES
# ============================================================

def ensure_rules_table(db):

    if not table_exists(
        db,
        "rules",
    ):

        db.execute(
            text(
                """
                CREATE TABLE public.rules (
                    id TEXT PRIMARY KEY,
                    regulation_id TEXT,
                    rule_text TEXT NOT NULL,
                    source_text TEXT DEFAULT '',
                    page_start INTEGER,
                    page_end INTEGER,
                    metadata JSONB DEFAULT '{}'::jsonb,
                    created_at TIMESTAMP
                        DEFAULT CURRENT_TIMESTAMP
                )
                """
            )
        )

        db.execute(
            text(
                """
                CREATE INDEX
                    ix_udcpr_rules_regulation_id
                ON public.rules(regulation_id)
                """
            )
        )


