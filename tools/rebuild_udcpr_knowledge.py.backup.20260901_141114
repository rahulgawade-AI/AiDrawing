# ============================================================
# VERIFY
# ============================================================

def verify(
    db,
    expected_rules,
    expected_cards,
):

    result = {}

    result[
        "rules"
    ] = count_table(
        db,
        "rules",
    )

    result[
        "knowledge_cards"
    ] = count_table(
        db,
        "knowledge_cards",
    )

    result[
        "expected_rules"
    ] = expected_rules

    result[
        "expected_cards"
    ] = expected_cards

    result[
        "rule_orphans"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.rules x
            LEFT JOIN regulations r
              ON r.id = x.regulation_id
            WHERE x.regulation_id IS NOT NULL
              AND r.id IS NULL
            """
        )
    ).scalar_one()

    result[
        "card_orphans"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.knowledge_cards x
            LEFT JOIN regulations r
              ON r.id = x.regulation_id
            WHERE x.regulation_id IS NOT NULL
              AND r.id IS NULL
            """
        )
    ).scalar_one()

    result[
        "passed"
    ] = (
        result["rules"]
        == expected_rules
        and
        result["knowledge_cards"]
        == expected_cards
        and
        result["rule_orphans"]
        == 0
        and
        result["card_orphans"]
        == 0
    )

    return result


# ============================================================
# MAIN
# ============================================================

def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--manifest",
        default=DEFAULT_MANIFEST,
    )

    parser.add_argument(
        "--chunks",
        default=DEFAULT_CHUNKS,
    )

    parser.add_argument(
        "--report",
        default=DEFAULT_REPORT,
    )

    parser.add_argument(
        "--apply",
        action="store_true",
    )

    args = parser.parse_args()

    print("=" * 120)
    print(
        "UDCPR RULE + KNOWLEDGE CARD REBUILD"
    )
    print("=" * 120)

    print()

    if args.apply:

        print(
            "!!! APPLY MODE !!!"
        )

        print(
            "Existing rules and knowledge_cards "
            "will be backed up."
        )

        print(
            "regulations and tables will NOT "
            "be modified."
        )

    else:

        print(
            "DRY-RUN MODE"
        )

        print(
            "No PostgreSQL changes will be committed."
        )

    print()

    (
        manifest_by_key,
        chunks_by_key,
    ) = load_source(
        args.manifest,
        args.chunks,
    )

    print(
        "Manifest regulations:",
        len(manifest_by_key),
    )

    print(
        "Source chunks:",
        sum(
            len(x)
            for x in chunks_by_key.values()
        ),
    )

    if len(manifest_by_key) != EXPECTED_REGULATIONS:

        raise RuntimeError(
            "Expected "
            f"{EXPECTED_REGULATIONS} canonical "
            "regulations, got "
            f"{len(manifest_by_key)}"
        )

    db = SessionLocal()

    try:

        print()
        print("=" * 120)
        print("DATABASE")
        print("=" * 120)

        for table in (
            "regulations",
            "tables",
            "rules",
            "knowledge_cards",
        ):

            print(
                f"{table:<20}",
                count_table(
                    db,
                    table,
                ),
            )

        (
            selected,
            missing,
            ambiguous,
        ) = select_regulations(
            db,
            manifest_by_key,
        )

        print()
        print(
            "Selected regulations:",
            len(selected),
        )

        print(
            "Missing regulations:",
            len(missing),
        )

        print(
            "Ambiguous regulations:",
            len(ambiguous),
        )

        if missing:

            raise RuntimeError(
                "Missing canonical regulations: "
                + ", ".join(missing[:20])
            )

        if ambiguous:

            raise RuntimeError(
                "Ambiguous canonical regulations. "
                "Resolve before rebuild."
            )

        rule_rows = build_rule_rows(
            manifest_by_key,
            chunks_by_key,
            selected,
        )

        card_rows = build_card_rows(
            manifest_by_key,
            chunks_by_key,
            selected,
            rule_rows,
        )

        print()
        print(
            "Rules to rebuild:",
            len(rule_rows),
        )

        print(
            "Knowledge cards to rebuild:",
            len(card_rows),
        )

        report = {
            "created_at":
                datetime.now().isoformat(),
            "mode":
                "apply"
                if args.apply
                else "dry-run",
            "manifest":
                args.manifest,
            "chunks":
                args.chunks,
            "canonical_regulations":
                len(manifest_by_key),
            "selected_regulations":
                len(selected),
            "missing":
                missing,
            "ambiguous":
                ambiguous,
            "rules_to_rebuild":
                len(rule_rows),
            "knowledge_cards_to_rebuild":
                len(card_rows),
        }

        if not args.apply:

            report[
                "status"
            ] = "READY_FOR_APPLY"

            write_json(
                args.report,
                report,
            )

            print()
            print("=" * 120)
            print("DRY-RUN COMPLETE")
            print("=" * 120)

            print(
                "Rules:",
                len(rule_rows),
            )

            print(
                "Knowledge cards:",
                len(card_rows),
            )

            print(
                "STATUS: READY FOR --apply"
            )

            print(
                "Report:",
                args.report,
            )

            return

        # ----------------------------------------------------
        # TRANSACTION
        # ----------------------------------------------------

        timestamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S"
        )

        backup_dir = Path(
            "/tmp/udcpr_postgres_backup"
        ) / (
            "knowledge_rebuild_"
            + timestamp
        )

        backup_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        print()
        print(
            "Backup directory:",
            backup_dir,
        )

        # ----------------------------------------------------
        # BACKUP EXISTING TABLE DATA
        # ----------------------------------------------------

        print(
            "Backing up rules..."
        )

        old_rules = db.execute(
            text(
                """
                SELECT *
                FROM public.rules
                """
            )
        ).mappings().all()

        write_json(
            str(
                backup_dir
                / "rules.json"
            ),
            [dict(x) for x in old_rules],
        )

        print(
            "Backing up knowledge_cards..."
        )

        old_cards = db.execute(
            text(
                """
                SELECT *
                FROM public.knowledge_cards
                """
            )
        ).mappings().all()

        write_json(
            str(
                backup_dir
                / "knowledge_cards.json"
            ),
            [dict(x) for x in old_cards],
        )

        # ----------------------------------------------------
        # CLEAR KNOWLEDGE TABLES
        # ----------------------------------------------------

        print(
            "Clearing rules..."
        )

        db.execute(
            text(
                """
                DELETE FROM public.rules
                """
            )
        )

        print(
            "Clearing knowledge_cards..."
        )

        db.execute(
            text(
                """
                DELETE FROM public.knowledge_cards
                """
            )
        )

        ensure_rules_table(
            db
        )

        ensure_knowledge_cards_table(
            db
        )

        # ----------------------------------------------------
        # INSERT
        # ----------------------------------------------------

        print(
            "Inserting canonical rules..."
        )

        insert_rules(
            db,
            rule_rows,
        )

        print(
            "Inserting knowledge cards..."
        )

        insert_cards(
            db,
            card_rows,
        )

        # ----------------------------------------------------
        # VERIFY BEFORE COMMIT
        # ----------------------------------------------------

        verification = verify(
            db,
            len(rule_rows),
            len(card_rows),
        )

        print()
        print(
            json.dumps(
                verification,
                indent=2,
            )
        )

        if not verification[
            "passed"
        ]:

            raise RuntimeError(
                "Verification failed. "
                "Transaction will be rolled back."
            )

        db.commit()

        report[
            "status"
        ] = "SUCCESS"

        report[
            "backup_directory"
        ] = str(
            backup_dir
        )

        report[
            "verification"
        ] = verification

        write_json(
            args.report,
            report,
        )

        print()
        print("=" * 120)
        print("KNOWLEDGE REBUILD SUCCESSFUL")
        print("=" * 120)

        print(
            "Rules:",
            len(rule_rows),
        )

        print(
            "Knowledge cards:",
            len(card_rows),
        )

        print(
            "Backup:",
            backup_dir,
        )

        print(
            "Report:",
            args.report,
        )

    except Exception as exc:

        db.rollback()

        report = {
            "created_at":
                datetime.now().isoformat(),
            "mode":
                "apply",
            "status":
                "ABORTED",
            "error":
                str(exc),
        }

        write_json(
            args.report,
            report,
        )

        print()
        print("=" * 120)
        print("REBUILD ABORTED")
        print("=" * 120)

        print(
            "NO COMMITTED DATABASE CHANGES."
        )

        print(
            "Report:",
            args.report,
        )

        raise

    finally:

        db.close()


if __name__ == "__main__":
    main()
