# ============================================================
# RULE EXTRACTION
# ============================================================

def make_rule_text(
    text_value: str,
) -> str:

    value = normalize(
        text_value
    )

    if not value:
        return ""

    return value


def build_rule_rows(
    manifest_by_key,
    chunks_by_key,
    selected,
):

    rows = []

    for key, entry in (
        manifest_by_key.items()
    ):

        regulation = selected[
            key
        ]

        chunks = chunks_by_key[
            key
        ]

        if len(chunks) != 1:
            raise RuntimeError(
                f"Expected exactly one source "
                f"chunk for {key}; got "
                f"{len(chunks)}"
            )

        chunk = chunks[0]

        text_value = make_rule_text(
            chunk_text(chunk)
        )

        if not text_value:
            continue

        page_start = (
            chunk.get(
                "pdf_page_start"
            )
            or chunk.get(
                "page_number"
            )
        )

        page_end = (
            chunk.get(
                "pdf_page_end"
            )
            or page_start
        )

        rule_id = str(
            uuid.uuid5(
                uuid.NAMESPACE_URL,
                "udcpr-rule:"
                + str(regulation.id),
            )
        )

        rows.append(
            {
                "id": rule_id,
                "regulation_id":
                    str(regulation.id),
                "rule_text":
                    text_value,
                "source_text":
                    text_value,
                "page_start":
                    page_start,
                "page_end":
                    page_end,
                "metadata": {
                    "source":
                        "udcpr_source_chunks.json",
                    "canonical_key":
                        key,
                    "number":
                        entry.get("number"),
                    "title":
                        entry.get("title"),
                    "sha256":
                        sha256(text_value),
                },
            }
        )

    return rows


# ============================================================
# KNOWLEDGE CARDS
# ============================================================

def make_summary(
    entry: dict,
    source_text: str,
) -> str:

    """
    Deterministic first-pass knowledge card.

    IMPORTANT:
    This intentionally does NOT invent planning rules.

    The complete source text remains attached to
    the card so a later LLM summarizer can produce
    a planning-service-specific summary.
    """

    number = normalize(
        entry.get("number")
    )

    title = normalize(
        entry.get("title")
    )

    return (
        f"UDCPR Regulation {number}: "
        f"{title}. "
        f"This knowledge card is sourced from "
        f"the canonical UDCPR regulation text. "
        f"Use the attached source text as the "
        f"authoritative rule content."
    )


def build_card_rows(
    manifest_by_key,
    chunks_by_key,
    selected,
    rule_rows,
):

    rule_by_regulation = {
        row["regulation_id"]:
            row
        for row in rule_rows
    }

    rows = []

    for key, entry in (
        manifest_by_key.items()
    ):

        regulation = selected[
            key
        ]

        chunks = chunks_by_key[
            key
        ]

        chunk = chunks[0]

        source_text = normalize(
            chunk_text(chunk)
        )

        if not source_text:
            continue

        page_start = (
            chunk.get(
                "pdf_page_start"
            )
            or chunk.get(
                "page_number"
            )
        )

        page_end = (
            chunk.get(
                "pdf_page_end"
            )
            or page_start
        )

        rule = rule_by_regulation.get(
            str(regulation.id)
        )

        card_id = str(
            uuid.uuid5(
                uuid.NAMESPACE_URL,
                "udcpr-card:"
                + str(regulation.id),
            )
        )

        rows.append(
            {
                "id": card_id,
                "regulation_id":
                    str(regulation.id),
                "rule_id":
                    rule["id"]
                    if rule
                    else None,
                "title":
                    normalize(
                        entry.get("title")
                    ),
                "summary":
                    make_summary(
                        entry,
                        source_text,
                    ),
                "source_text":
                    source_text,
                "page_start":
                    page_start,
                "page_end":
                    page_end,
                "metadata": {
                    "source":
                        "udcpr_source_chunks.json",
                    "canonical_key":
                        key,
                    "number":
                        entry.get("number"),
                    "chapter":
                        entry.get("chapter"),
                    "sha256":
                        sha256(source_text),
                },
            }
        )

    return rows


# ============================================================
# INSERT RULES
# ============================================================

def insert_rules(
    db,
    rows,
):

    for row in rows:

        db.execute(
            text(
                """
                INSERT INTO public.rules (
                    id,
                    regulation_id,
                    rule_text,
                    source_text,
                    page_start,
                    page_end,
                    metadata
                )
                VALUES (
                    :id,
                    :regulation_id,
                    :rule_text,
                    :source_text,
                    :page_start,
                    :page_end,
                    CAST(:metadata AS jsonb)
                )
                """
            ),
            {
                **row,
                "metadata":
                    json.dumps(
                        row["metadata"],
                        ensure_ascii=False,
                    ),
            },
        )


