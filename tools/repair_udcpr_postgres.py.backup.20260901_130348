#!/usr/bin/env python3

"""
UDCPR PostgreSQL REBUILD

Rebuilds the PostgreSQL `tables` table from the authoritative
UDCPR source chunks.

AUTHORITATIVE INPUT:
    data/regulations/udcpr_canonical_manifest.json
    data/regulations/udcpr_source_chunks.json

DATABASE:
    PostgreSQL
    regulations
    tables

IMPORTANT:

    - Dry-run is the default.
    - --apply performs the actual rebuild.
    - regulations are NOT deleted.
    - Existing tables are NOT used to determine ownership.
    - Existing table -> regulation mappings are ignored.
    - Source chunks are authoritative for table ownership.
    - Existing `tables` is renamed to a timestamped backup table.
    - A new `tables` table is created.
    - Source tables are inserted into the new table.
    - The operation is transactional.
    - Verification happens before COMMIT.
    - On failure, the transaction is rolled back.
    - Backup table remains after successful rebuild.

EXPECTED SOURCE:
    329 canonical chunks
    approximately 1087 source tables

EXPECTED TABLE COLUMNS:

    id
    regulation_id
    page_number
    table_index
    title
    headers
    rows
    markdown
    metadata
    created_at

The script deliberately does not attempt fuzzy table matching.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from collections import defaultdict
from datetime import datetime
from pathlib import Path
from uuid import uuid4

from sqlalchemy import text

from townplanning.infrastructure.database.session import SessionLocal
from townplanning.infrastructure.database.models import RegulationModel


