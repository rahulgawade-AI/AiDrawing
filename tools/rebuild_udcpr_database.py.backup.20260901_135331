# ============================================================
# GENERAL HELPERS
# ============================================================

def normalize_space(value: Any) -> str:
    if value is None:
        return ""

    return re.sub(
        r"\s+",
        " ",
        str(value),
    ).strip()


def normalize_number(value: Any) -> str:
    value = normalize_space(value)

    if not value:
        return ""

    value = value.replace(" ", "")

    value = re.sub(
        r"\s*\(\s*([a-z])\s*\)",
        r"(\1)",
        value,
        flags=re.IGNORECASE,
    )

    return value


def normalize_title(value: Any) -> str:
    return normalize_space(value).lower()


def regulation_key(
    number: Any,
    title: Any,
) -> str:

    return (
        normalize_number(number)
        + "|"
        + normalize_title(title)
    )


def sha256_text(value: Any) -> str:
    if value is None:
        value = ""

    value = str(value)

    value = value.replace(
        "\r\n",
        "\n",
    ).replace(
        "\r",
        "\n",
    )

    return hashlib.sha256(
        value.encode("utf-8")
    ).hexdigest()


def safe_json(value: Any) -> Any:
    """
    Convert values into JSON-safe values.
    """

    if value is None:
        return None

    if isinstance(
        value,
        (
            str,
            int,
            float,
            bool,
        ),
    ):
        return value

    if isinstance(value, dict):
        return {
            str(k): safe_json(v)
            for k, v in value.items()
        }

    if isinstance(value, (list, tuple)):
        return [
            safe_json(v)
            for v in value
        ]

    return str(value)


# ============================================================
# JSON LOADING
# ============================================================

def load_json(path: str) -> Any:

    with open(
        path,
        "r",
        encoding="utf-8",
    ) as f:
        return json.load(f)


def extract_manifest_entries(
    data: Any,
) -> list[dict]:

    if isinstance(data, list):
        return data

    if not isinstance(data, dict):
        raise RuntimeError(
            "Manifest must be a JSON object or list."
        )

    for key in (
        "regulations",
        "entries",
        "items",
    ):

        value = data.get(key)

        if isinstance(value, list):
            return value

    raise RuntimeError(
        "Could not find regulations/entries/items "
        "in canonical manifest."
    )


def extract_chunks(
    data: Any,
) -> list[dict]:

    if isinstance(data, list):
        return data

    if not isinstance(data, dict):
        raise RuntimeError(
            "Chunks must be a JSON object or list."
        )

    for key in (
        "chunks",
        "source_chunks",
        "items",
    ):

        value = data.get(key)

        if isinstance(value, list):
            return value

    raise RuntimeError(
        "Could not find chunks/source_chunks/items "
        "in source chunks JSON."
    )


# ============================================================
# CHUNK HELPERS
# ============================================================

def chunk_number(
    chunk: dict,
) -> str:

    for key in (
        "number",
        "regulation_number",
        "rule_number",
    ):

        value = chunk.get(key)

        if value is not None:
            return str(value)

    return ""


def chunk_title(
    chunk: dict,
) -> str:

    for key in (
        "title",
        "regulation_title",
        "rule_title",
    ):

        value = chunk.get(key)

        if value is not None:
            return str(value)

    return ""


def chunk_text(
    chunk: dict,
) -> str:

    for key in (
        "regulation_text",
        "text",
        "source_text",
        "content",
        "markdown",
    ):

        value = chunk.get(key)

        if isinstance(
            value,
            str,
        ):
            return value

    return ""


def chunk_tables(
    chunk: dict,
) -> list[dict]:

    for key in (
        "tables",
        "source_tables",
    ):

        value = chunk.get(key)

        if isinstance(
            value,
            list,
        ):
            return value

    return []


# ============================================================
# SOURCE TABLE HELPERS
# ============================================================

def source_table_page(
    table: dict,
) -> int:

    for key in (
        "pdf_page",
        "page_number",
        "page",
    ):

        value = table.get(key)

        if value is None:
            continue

        try:
            return int(value)
        except (
            TypeError,
            ValueError,
        ):
            pass

    raise RuntimeError(
        "Source table has no valid PDF page."
    )


def source_table_index(
    table: dict,
) -> int:

    for key in (
        "table_index",
        "index",
    ):

        value = table.get(key)

        if value is None:
            continue

        try:
            return int(value)
        except (
            TypeError,
            ValueError,
        ):
            pass

    raise RuntimeError(
        "Source table has no valid table index."
    )


def source_table_title(
    table: dict,
) -> str:

    value = table.get(
        "title",
        "",
    )

    if value is None:
        return ""

    return str(value)


def source_table_markdown(
    table: dict,
) -> str:

    for key in (
        "markdown",
        "table_markdown",
    ):

        value = table.get(key)

        if isinstance(
            value,
            str,
        ):
            return value

    return ""


def source_table_headers(
    table: dict,
) -> Any:

    for key in (
        "headers",
        "columns",
    ):

        if key in table:
            value = table.get(key)

            if value is None:
                return []

            return value

    return []


def source_table_rows(
    table: dict,
) -> Any:

    for key in (
        "rows",
        "data",
    ):

        if key in table:
            value = table.get(key)

            if value is None:
                return []

            return value

    return []


def source_table_metadata(
    table: dict,
) -> dict:

    value = table.get(
        "metadata",
        {},
    )

    if isinstance(
        value,
        dict,
    ):
        return value

    return {}


# ============================================================
# CANONICAL INDEX
# ============================================================

def build_canonical_index(
    manifest_entries: list[dict],
    chunks: list[dict],
):

    manifest_by_key = {}

    for entry in manifest_entries:

        number = entry.get(
            "number"
        )

        title = entry.get(
            "title"
        )

        key = regulation_key(
            number,
            title,
        )

        if not key.strip("|"):

            raise RuntimeError(
                "Manifest entry has no number/title."
            )

        if key in manifest_by_key:

            raise RuntimeError(
                "Duplicate canonical manifest key: "
                + key
            )

        manifest_by_key[
            key
        ] = entry

    chunks_by_key = defaultdict(
        list
    )

    for chunk in chunks:

        number = chunk_number(
            chunk
        )

        title = chunk_title(
            chunk
        )

        key = regulation_key(
            number,
            title,
        )

        chunks_by_key[
            key
        ].append(
            chunk
        )

    problems = []

    for key in manifest_by_key:

        count = len(
            chunks_by_key.get(
                key,
                [],
            )
        )

        if count != 1:

            problems.append(
                {
                    "key": key,
                    "chunk_count": count,
                }
            )

    if problems:

        raise RuntimeError(
            "Canonical manifest/chunk mapping is not "
            "one-to-one. Problems: "
            + json.dumps(
                problems[:20],
                indent=2,
            )
        )

    return (
        manifest_by_key,
        {
            key: values[0]
            for key, values
            in chunks_by_key.items()
        },
    )


# ============================================================
# DATABASE INSPECTION
# ============================================================

def table_exists(
    db,
    table_name: str,
) -> bool:

    return bool(
        db.execute(
            text(
                """
                SELECT EXISTS (
                    SELECT 1
                    FROM information_schema.tables
                    WHERE table_schema = 'public'
                      AND table_name = :table_name
                )
                """
            ),
            {
                "table_name":
                    table_name,
            },
        ).scalar_one()
    )


def count_table(
    db,
    table_name: str,
) -> int:

    return int(
        db.execute(
            text(
                f'SELECT COUNT(*) FROM "{table_name}"'
            )
        ).scalar_one()
    )


def get_existing_tables_info(
    db,
) -> dict:

    result = {}

    for name in (
        "regulations",
        "tables",
        "rules",
        "knowledge_cards",
    ):

        exists = table_exists(
            db,
            name,
        )

        result[name] = {
            "exists": exists,
            "count":
                count_table(
                    db,
                    name,
                )
                if exists
                else None,
        }

    return result


# ============================================================
# BACKUP REGULATION / RULE DATA
