def write_json_backup(
    db,
    table_name: str,
    output_path: Path,
):

    if not table_exists(
        db,
        table_name,
    ):
        return False

    rows = db.execute(
        text(
            f'SELECT * FROM "{table_name}"'
        )
    ).mappings().all()

    payload = {
        "created_at":
            datetime.now().isoformat(),

        "table":
            table_name,

        "row_count":
            len(rows),

        "rows":
            [
                {
                    key:
                        safe_json(value)
                    for key, value
                    in row.items()
                }
                for row in rows
            ],
    }

    output_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    with open(
        output_path,
        "w",
        encoding="utf-8",
    ) as f:

        json.dump(
            payload,
            f,
            indent=2,
            ensure_ascii=False,
        )

    return True


# ============================================================
# CREATE TABLE
# ============================================================

def create_tables_table(
    db,
):

    db.execute(
        text(
            """
            CREATE TABLE public."tables" (

                id TEXT PRIMARY KEY,

                regulation_id TEXT NOT NULL,

                page_number INTEGER NOT NULL,

                table_index INTEGER NOT NULL,

                title TEXT DEFAULT '',

                headers JSONB DEFAULT '[]'::jsonb,

                rows JSONB DEFAULT '[]'::jsonb,

                markdown TEXT DEFAULT '',

                metadata JSONB DEFAULT '{}'::jsonb,

                created_at TIMESTAMP
                    DEFAULT CURRENT_TIMESTAMP,

                CONSTRAINT
                    tables_regulation_id_fkey

                    FOREIGN KEY (
                        regulation_id
                    )

                    REFERENCES
                        public.regulations(id)

                    ON DELETE CASCADE
            )
            """
        )
    )

    db.execute(
        text(
            """
            CREATE INDEX
                ix_tables_regulation_id

            ON public."tables" (
                regulation_id
            )
            """
        )
    )

    db.execute(
        text(
            """
            CREATE INDEX
                ix_tables_page_number

            ON public."tables" (
                page_number
            )
            """
        )
    )


# ============================================================
# INSERT SOURCE TABLES
# ============================================================

def insert_source_tables(
    db,
    manifest_by_key,
    chunks_by_key,
    selected_regulations,
):

    inserted = 0

    problems = []

    generated_ids = set()

    for key, entry in manifest_by_key.items():

        regulation = selected_regulations.get(
            key
        )

        if regulation is None:

            problems.append(
                {
                    "key": key,
                    "reason":
                        "Canonical regulation does not "
                        "exist in PostgreSQL.",
                }
            )

            continue

        chunk = chunks_by_key[
            key
        ]

        source_tables = chunk_tables(
            chunk
        )

        for table_position, source_table in enumerate(
            source_tables,
            start=1,
        ):

            try:

                page_number = source_table_page(
                    source_table
                )

                table_index = source_table_index(
                    source_table
                )

            except RuntimeError as exc:

                problems.append(
                    {
                        "key": key,
                        "table_position":
                            table_position,
                        "reason":
                            str(exc),
                    }
                )

                continue

            markdown = source_table_markdown(
                source_table
            )

            headers = source_table_headers(
                source_table
            )

            rows = source_table_rows(
                source_table
            )

            title = source_table_title(
                source_table
            )

            metadata = source_table_metadata(
                source_table
            )

            # ------------------------------------------------
            # Stable deterministic ID.
            #
            # This means rebuilding from the same source
            # produces the same table IDs.
            # ------------------------------------------------

            identity = (
                str(regulation.id)
                + "|"
                + str(page_number)
                + "|"
                + str(table_index)
                + "|"
                + str(table_position)
                + "|"
                + sha256_text(markdown)
            )

            table_id = hashlib.sha256(
                identity.encode(
                    "utf-8"
                )
            ).hexdigest()

            if table_id in generated_ids:

                problems.append(
                    {
                        "key": key,
                        "page":
                            page_number,
                        "table_index":
                            table_index,
                        "reason":
                            "Generated duplicate table ID.",
                    }
                )

                continue

            generated_ids.add(
                table_id
            )

            # ------------------------------------------------
            # Add source information to metadata.
            # ------------------------------------------------

            final_metadata = dict(
                metadata
            )

            final_metadata[
                "source"
            ] = "udcpr_source_chunks"

            final_metadata[
                "canonical_regulation_number"
            ] = entry.get(
                "number"
            )

            final_metadata[
                "canonical_regulation_title"
            ] = entry.get(
                "title"
            )

            final_metadata[
                "source_table_position"
            ] = table_position

            final_metadata[
                "source_markdown_sha256"
            ] = sha256_text(
                markdown
            )

            final_metadata[
                "source_chunk_key"
            ] = key

            db.execute(
                text(
                    """
                    INSERT INTO public."tables" (
                        id,
                        regulation_id,
                        page_number,
                        table_index,
                        title,
                        headers,
                        rows,
                        markdown,
                        metadata
                    )
                    VALUES (
                        :id,
                        :regulation_id,
                        :page_number,
                        :table_index,
                        :title,
                        CAST(
                            :headers AS JSONB
                        ),
                        CAST(
                            :rows AS JSONB
                        ),
                        :markdown,
                        CAST(
                            :metadata AS JSONB
                        )
                    )
                    """
                ),
                {
                    "id":
                        table_id,

                    "regulation_id":
                        str(
                            regulation.id
                        ),

                    "page_number":
                        page_number,

                    "table_index":
                        table_index,

                    "title":
                        title,

                    "headers":
                        json.dumps(
                            safe_json(
                                headers
                            ),
                            ensure_ascii=False,
                        ),

                    "rows":
                        json.dumps(
                            safe_json(
                                rows
                            ),
                            ensure_ascii=False,
                        ),

                    "markdown":
                        markdown,

                    "metadata":
                        json.dumps(
                            safe_json(
                                final_metadata
                            ),
                            ensure_ascii=False,
                        ),
                },
            )

            inserted += 1

    return (
        inserted,
        problems,
    )


# ============================================================
# VERIFY REBUILT TABLE
# ============================================================

def verify_rebuilt_tables(
    db,
    expected_source_table_count: int,
):

    database_table_count = int(
        db.execute(
            text(
                'SELECT COUNT(*) FROM public."tables"'
            )
        ).scalar_one()
    )

    orphan_count = int(
        db.execute(
            text(
                """
                SELECT COUNT(*)
                FROM public."tables" t
                LEFT JOIN public.regulations r
                  ON r.id = t.regulation_id
                WHERE r.id IS NULL
                """
            )
        ).scalar_one()
    )

    invalid_page_or_index_count = int(
        db.execute(
            text(
                """
                SELECT COUNT(*)
                FROM public."tables"
                WHERE page_number <= 0
                   OR table_index <= 0
                """
            )
        ).scalar_one()
    )

    duplicate_identity_count = int(
        db.execute(
            text(
                """
                SELECT COUNT(*)
                FROM (
                    SELECT
                        regulation_id,
                        page_number,
                        table_index,
                        COUNT(*) AS c
                    FROM public."tables"
                    GROUP BY
                        regulation_id,
                        page_number,
                        table_index
                    HAVING COUNT(*) > 1
                ) x
                """
            )
        ).scalar_one()
    )

    failures = []

    if (
        database_table_count
        != expected_source_table_count
    ):

        failures.append(
            (
                "Table count mismatch: "
                f"expected {expected_source_table_count}, "
                f"got {database_table_count}"
            )
        )

    if orphan_count != 0:

        failures.append(
            f"Orphan tables: {orphan_count}"
        )

    if invalid_page_or_index_count != 0:

        failures.append(
            "Invalid page/index rows: "
            f"{invalid_page_or_index_count}"
        )

    verification = {
        "source_table_count":
            expected_source_table_count,

        "database_table_count":
            database_table_count,

        "orphan_count":
            orphan_count,

        "invalid_page_or_index_count":
            invalid_page_or_index_count,

        "duplicate_regulation_page_index_groups":
            duplicate_identity_count,

        "failures":
            failures,

        "passed":
            len(failures) == 0,
    }

    return verification


# ============================================================
# SELECT CANONICAL REGULATIONS
# ============================================================

def select_regulations(
    db,
    manifest_by_key,
):

    rows = (
        db.query(
            RegulationModel
        )
        .all()
    )

    by_key = defaultdict(
        list
    )

    for row in rows:

        key = regulation_key(
            row.number,
            row.title,
        )

        by_key[
            key
        ].append(
            row
        )

    selected = {}

    missing = []

    ambiguous = []

    for key, entry in manifest_by_key.items():

        candidates = by_key.get(
            key,
            []
        )

        if len(candidates) == 0:

            missing.append(
                {
                    "key": key,
                    "number":
                        entry.get("number"),
                    "title":
                        entry.get("title"),
                }
            )

            continue

        # ----------------------------------------------------
        # IMPORTANT
        #
        # We no longer require exactly one old DB row.
        #
        # Existing DB may contain historical duplicates.
        #
        # We choose the candidate based on the canonical
        # manifest's printed/PDF page information.
        # ----------------------------------------------------

        expected_pdf_page = (
            entry.get(
                "pdf_page_start"
            )
        )

        expected_printed_page = (
            entry.get(
                "printed_page_start"
            )
        )

        scored = []

        for row in candidates:

            score = 0

            row_page_start = getattr(
                row,
                "page_start",
                None,
            )

            row_page_end = getattr(
                row,
                "page_end",
                None,
            )

            if (
                expected_printed_page is not None
                and row_page_start
                == expected_printed_page
            ):
                score += 100

            if (
                expected_pdf_page is not None
                and (
                    row_page_start
                    == expected_pdf_page
                    or
                    row_page_end
                    == expected_pdf_page
                )
            ):
                score += 50

            # Prefer the row with the earliest page when
            # no explicit page match is possible.
            try:
                page_value = int(
                    row_page_start
                    or 999999
                )
            except (
                TypeError,
                ValueError,
            ):
                page_value = 999999

            scored.append(
                (
                    score,
                    -page_value,
                    str(row.id),
                    row,
                )
            )

        scored.sort(
            reverse=True
        )

        best = scored[0]

        # ----------------------------------------------------
        # If multiple rows tie at the top, report ambiguous.
        # ----------------------------------------------------

        if (
            len(scored) > 1
            and scored[0][0]
            == scored[1][0]
            and scored[0][1]
            == scored[1][1]
        ):

            ambiguous.append(
                {
                    "key": key,
                    "number":
                        entry.get("number"),
                    "title":
                        entry.get("title"),
                    "candidate_ids":
                        [
                            str(x[2])
                            for x in scored
                        ],
                }
            )

            continue

        selected[
            key
        ] = best[3]

    return (
        selected,
        missing,
        ambiguous,
    )


# ============================================================
# BACKUP OLD TABLE
# ============================================================

def rename_existing_tables(
    db,
    backup_name: str,
):

    if not table_exists(
        db,
        "tables",
    ):
        return False

    db.execute(
        text(
            f'''
            ALTER TABLE public."tables"
            RENAME TO "{backup_name}"
            '''
        )
    )

    return True


