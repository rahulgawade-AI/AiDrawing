            "Existing tables will be renamed "
            "to a timestamped backup."
        )

        print(
            "A new tables table will be created."
        )

        print(
            "regulations will NOT be modified."
        )

    else:

        print(
            "DRY-RUN MODE"
        )

        print(
            "No PostgreSQL changes will be committed."
        )

    print()

    print(
        "Manifest:",
        args.manifest,
    )

    print(
        "Chunks:",
        args.chunks,
    )

    print(
        "Report:",
        args.report,
    )

    print()

    # --------------------------------------------------------
    # Load source
    # --------------------------------------------------------

    manifest_data = load_json(
        args.manifest
    )

    chunk_data = load_json(
        args.chunks
    )

    manifest_entries = extract_manifest_entries(
        manifest_data
    )

    chunks = extract_chunks(
        chunk_data
    )

    print(
        "Manifest regulations:",
        len(manifest_entries),
    )

    print(
        "Source chunks:",
        len(chunks),
    )

    source_table_count = sum(
        len(
            chunk_tables(chunk)
        )
        for chunk in chunks
    )

    print(
        "Source tables:",
        source_table_count,
    )

    print()

    if (
        len(manifest_entries)
        != EXPECTED_REGULATIONS
    ):

        raise RuntimeError(
            "Unexpected canonical regulation count: "
            f"{len(manifest_entries)} "
            f"(expected {EXPECTED_REGULATIONS})"
        )

    if (
        len(chunks)
        != EXPECTED_CHUNKS
    ):

        raise RuntimeError(
            "Unexpected source chunk count: "
            f"{len(chunks)} "
            f"(expected {EXPECTED_CHUNKS})"
        )

    if (
        source_table_count
        != EXPECTED_TABLES
    ):

        raise RuntimeError(
            "Unexpected source table count: "
            f"{source_table_count} "
            f"(expected {EXPECTED_TABLES})"
        )

    (
        manifest_by_key,
        chunks_by_key,
    ) = build_canonical_index(
        manifest_entries,
        chunks,
    )

    db = SessionLocal()

    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    backup_dir = (
        Path(args.backup_dir)
        / (
            "udcpr_"
            + timestamp
        )
    )

    backup_table_name = (
        "tables_backup_"
        + timestamp
    )

    try:

        # ----------------------------------------------------
        # Inspect DB
        # ----------------------------------------------------

        existing = get_existing_tables_info(
            db
        )

        print(
            "=" * 120
        )

        print(
            "EXISTING DATABASE"
        )

        print(
            "=" * 120
        )

        for name, info in existing.items():

            print(
                f"{name:20} "
                f"exists={info['exists']} "
                f"count={info['count']}"
            )

        print()

        # ----------------------------------------------------
        # Select canonical regulations.
        #
        # Existing duplicate rows are allowed.
        # We do NOT modify regulations.
        # ----------------------------------------------------

        (
            selected,
            missing,
            ambiguous,
        ) = select_regulations(
            db,
            manifest_by_key,
        )

        print(
            "Selected regulations:",
            len(selected),
        )

        print(
            "Missing regulations:",
            len(missing),
        )

        print(
            "Ambiguous regulations:",
            len(ambiguous),
        )

        if missing:

            print()

            print(
                "MISSING REGULATIONS:"
            )

            for item in missing[:50]:

                print(
                    " ",
                    item,
                )

        if ambiguous:

            print()

            print(
                "AMBIGUOUS REGULATIONS:"
            )

            for item in ambiguous[:50]:

                print(
                    " ",
                    item,
                )

        # ----------------------------------------------------
        # Stop before database modifications.
        # ----------------------------------------------------

        if missing or ambiguous:

            raise RuntimeError(
                "Canonical regulation selection failed."
            )

        if len(selected) != len(
            manifest_by_key
        ):

            raise RuntimeError(
                "Not all canonical regulations "
                "could be selected."
            )

        # ----------------------------------------------------
        # DRY RUN
        # ----------------------------------------------------

        if not args.apply:

            report = {
                "mode":
                    "dry-run",

                "created_at":
                    datetime.now().isoformat(),

                "manifest":
                    args.manifest,

                "chunks":
                    args.chunks,

                "canonical_regulations":
                    len(manifest_entries),

                "source_chunks":
                    len(chunks),

                "source_tables":
                    source_table_count,

                "selected_regulations":
                    len(selected),

                "missing_regulations":
                    len(missing),

                "ambiguous_regulations":
                    len(ambiguous),

                "would_backup_existing_tables":
                    existing[
                        "tables"
                    ][
                        "exists"
                    ],

                "would_create_tables":
                    True,

                "would_insert_tables":
                    source_table_count,

                "database_changes":
                    False,
            }

            write_report(
                args.report,
                report,
            )

            print()

            print(
                "=" * 120
            )

            print(
                "DRY-RUN COMPLETE"
            )

            print(
                "=" * 120
            )

            print(
                "Canonical regulations:",
                len(manifest_entries),
            )

            print(
                "Source chunks:",
                len(chunks),
            )

            print(
                "Source tables:",
                source_table_count,
            )

            print(
                "Selected regulations:",
                len(selected),
            )

            print(
                "Missing regulations:",
                len(missing),
            )

            print(
                "Ambiguous regulations:",
                len(ambiguous),
            )

            print()

            print(
                "STATUS: READY FOR --apply"
            )

            print()

            print(
                "Report:",
                args.report,
            )

            return

        # ====================================================
        # APPLY MODE
        # ====================================================

        print()

        print(
            "=" * 120
        )

        print(
            "STARTING TRANSACTIONAL REBUILD"
        )

        print(
            "=" * 120
        )

        # ----------------------------------------------------
        # Backup directory
        # ----------------------------------------------------

        backup_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        print()

        print(
            "Backup directory:",
            backup_dir,
        )

        # ----------------------------------------------------
        # Backup regulations
        # ----------------------------------------------------

        print(
            "Backing up regulations..."
        )

        regulations_backup = (
            backup_dir
            / "regulations.json"
        )

        write_json_backup(
            db,
            "regulations",
            regulations_backup,
        )

        # ----------------------------------------------------
        # Backup rules if present
        # ----------------------------------------------------

        rules_backup = (
            backup_dir
            / "rules.json"
        )

        if table_exists(
            db,
            "rules",
        ):

            print(
                "Backing up rules..."
            )

            write_json_backup(
                db,
                "rules",
                rules_backup,
            )

        # ----------------------------------------------------
        # Backup knowledge cards if present
        # ----------------------------------------------------

        cards_backup = (
            backup_dir
            / "knowledge_cards.json"
        )

        if table_exists(
            db,
            "knowledge_cards",
        ):

            print(
                "Backing up knowledge_cards..."
            )

            write_json_backup(
                db,
                "knowledge_cards",
                cards_backup,
            )

        # ----------------------------------------------------
        # Backup existing tables by rename.
        #
        # This is inside the same PostgreSQL transaction.
        # If anything fails, rollback restores the original
        # table name/state.
        # ----------------------------------------------------

        if table_exists(
            db,
            "tables",
        ):

            print()

            print(
                "Renaming existing tables ->",
                backup_table_name,
            )

            rename_existing_tables(
                db,
                backup_table_name,
            )

        else:

            print(
                "Existing tables table does not exist."
            )

        # ----------------------------------------------------
        # Create clean tables.
        # ----------------------------------------------------

        print(
            "Creating new public.tables..."
        )

        create_tables_table(
            db
        )

        # ----------------------------------------------------
        # Insert canonical source tables.
        # ----------------------------------------------------

        print(
            "Inserting source tables..."
        )

        (
            inserted,
            problems,
        ) = insert_source_tables(
            db=db,
            manifest_by_key=manifest_by_key,
            chunks_by_key=chunks_by_key,
            selected_regulations=selected,
        )

        if problems:

            raise RuntimeError(
                "Source table insertion encountered "
                f"{len(problems)} problems."
            )

        print(
            "Inserted:",
            inserted,
        )

        if inserted != source_table_count:

            raise RuntimeError(
                "Inserted table count mismatch: "
                f"expected {source_table_count}, "
                f"got {inserted}"
            )

        # ----------------------------------------------------
        # Verify BEFORE COMMIT.
        # ----------------------------------------------------

        print()

        print(
            "Running verification..."
        )

        verification = verify_rebuilt_tables(
            db,
            source_table_count,
        )

        print(
            json.dumps(
                verification,
                indent=2,
            )
        )

        if not verification[
            "passed"
        ]:

            raise RuntimeError(
                "Verification failed. "
                "Transaction will be rolled back."
            )

        # ----------------------------------------------------
        # Everything is correct.
        # Commit.
        # ----------------------------------------------------

        db.commit()

        report = {
            "mode":
                "apply",

            "created_at":
                datetime.now().isoformat(),

            "manifest":
                args.manifest,

            "chunks":
                args.chunks,

            "backup_directory":
                str(backup_dir),

            "backup_table":
                backup_table_name,

            "canonical_regulations":
                len(manifest_entries),

            "source_chunks":
                len(chunks),

            "source_tables":
                source_table_count,

            "selected_regulations":
                len(selected),

            "inserted_tables":
                inserted,

            "verification":
                verification,

            "committed":
                True,
        }

        write_report(
            args.report,
            report,
        )

        print()

        print(
            "=" * 120
        )

        print(
            "REBUILD SUCCESSFUL"
        )

        print(
            "=" * 120
        )

        print(
            "Backup table:",
            backup_table_name,
        )

        print(
            "Backup directory:",
            backup_dir,
        )

        print(
            "Inserted tables:",
            inserted,
        )

        print(
            "Verification:",
            verification,
        )

        print()

        print(
            "PostgreSQL transaction COMMITTED."
        )

        print(
            "The old tables data remains in:",
            backup_table_name,
        )

        print()

        print(
            "Report:",
            args.report,
        )

    except Exception as exc:

        db.rollback()

        print()

        print(
            "=" * 120
        )

        print(
            "REBUILD ABORTED"
        )

        print(
            "=" * 120
        )

        print(
            "NO COMMITTED DATABASE CHANGES."
        )

        print(
            "Report:",
            args.report,
        )

        print(
            "ERROR:",
            str(exc),
        )

        raise

    finally:

        db.close()


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":
    main()
