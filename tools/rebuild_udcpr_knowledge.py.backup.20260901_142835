def verify(
    db,
    expected_rules,
    expected_cards,
):

    rule_count = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.rules
            """
        )
    ).scalar_one()

    card_count = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.knowledge_cards
            """
        )
    ).scalar_one()

    rule_orphans = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.rules r
            LEFT JOIN public.regulations x
              ON x.id = r.regulation_id
            WHERE x.id IS NULL
            """
        )
    ).scalar_one()

    card_orphans = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.knowledge_cards k
            LEFT JOIN public.regulations r
              ON r.id = k.regulation_id
            WHERE r.id IS NULL
            """
        )
    ).scalar_one()

    duplicate_rule_regulations = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM (
                SELECT regulation_id, COUNT(*)
                FROM public.rules
                GROUP BY regulation_id
                HAVING COUNT(*) > 1
            ) x
            """
        )
    ).scalar_one()

    duplicate_cards = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM (
                SELECT regulation_id, COUNT(*)
                FROM public.knowledge_cards
                GROUP BY regulation_id
                HAVING COUNT(*) > 1
            ) x
            """
        )
    ).scalar_one()

    failures = []

    if rule_count != expected_rules:
        failures.append(
            f"Expected {expected_rules} rules; "
            f"found {rule_count}"
        )

    if card_count != expected_cards:
        failures.append(
            f"Expected {expected_cards} cards; "
            f"found {card_count}"
        )

    if rule_orphans:
        failures.append(
            f"{rule_orphans} orphan rules"
        )

    if card_orphans:
        failures.append(
            f"{card_orphans} orphan knowledge cards"
        )

    if duplicate_rule_regulations:
        failures.append(
            f"{duplicate_rule_regulations} regulations "
            f"have duplicate rules"
        )

    if duplicate_cards:
        failures.append(
            f"{duplicate_cards} regulations "
            f"have duplicate knowledge cards"
        )

    return {
        "rule_count":
            rule_count,

        "card_count":
            card_count,

        "expected_rules":
            expected_rules,

        "expected_cards":
            expected_cards,

        "rule_orphans":
            rule_orphans,

        "card_orphans":
            card_orphans,

        "duplicate_rule_regulations":
            duplicate_rule_regulations,

        "duplicate_cards":
            duplicate_cards,

        "failures":
            failures,

        "passed":
            len(failures) == 0,
    }


# ============================================================
# MAIN
# ============================================================

def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--manifest",
        required=True,
    )

    parser.add_argument(
        "--chunks",
        required=True,
    )

    parser.add_argument(
        "--report",
        required=True,
    )

    parser.add_argument(
        "--apply",
        action="store_true",
    )

    args = parser.parse_args()

    print("=" * 120)
    print(
        "UDCPR RULE + KNOWLEDGE CARD CLEAN REBUILD"
    )
    print("=" * 120)

    if args.apply:

        print()
        print("!!! APPLY MODE !!!")
        print(
            "Existing rules and knowledge_cards "
            "will be backed up and replaced."
        )
        print(
            "regulations and tables will NOT be modified."
        )

    else:

        print()
        print("DRY-RUN MODE")
        print(
            "No PostgreSQL changes will be committed."
        )

    manifest = load_manifest(
        args.manifest
    )

    chunks = load_chunks(
        args.chunks
    )

    manifest_by_key = build_manifest_index(
        manifest
    )

    chunks_by_key = build_chunk_index(
        chunks
    )

    print()
    print(
        f"Manifest regulations: {len(manifest_by_key)}"
    )

    print(
        f"Source chunks: {len(chunks)}"
    )

    db = SessionLocal()

    try:

        print_database_status(
            db
        )

        selected, missing, ambiguous = (
            select_regulations(
                db,
                manifest_by_key,
            )
        )

        print()
        print(
            f"Selected regulations: {len(selected)}"
        )

        print(
            f"Missing regulations: {len(missing)}"
        )

        print(
            f"Ambiguous regulations: {len(ambiguous)}"
        )

        if missing:

            print()
            print(
                "MISSING REGULATIONS:"
            )

            for item in missing:
                print(
                    item
                )

            raise RuntimeError(
                "Missing canonical regulations."
            )

        if ambiguous:

            print()
            print(
                "AMBIGUOUS REGULATIONS:"
            )

            for item in ambiguous:
                print(
                    item
                )

            raise RuntimeError(
                "Ambiguous canonical regulations."
            )

        rule_rows = build_rule_rows(
            manifest_by_key,
            chunks_by_key,
            selected,
        )

        card_rows = build_card_rows(
            manifest_by_key,
            chunks_by_key,
            selected,
            rule_rows,
        )

        print()
        print(
            f"Rules to rebuild: {len(rule_rows)}"
        )

        print(
            f"Knowledge cards to rebuild: "
            f"{len(card_rows)}"
        )

        report = {
            "created_at":
                datetime.now().isoformat(),

            "mode":
                "apply"
                if args.apply
                else "dry-run",

            "manifest_regulations":
                len(manifest_by_key),

            "source_chunks":
                len(chunks),

            "selected_regulations":
                len(selected),

            "missing":
                missing,

            "ambiguous":
                ambiguous,

            "rules":
                len(rule_rows),

            "knowledge_cards":
                len(card_rows),

            "verification":
                None,

            "errors":
                [],
        }

        if not args.apply:

            write_json(
                args.report,
                report,
            )

            print()
            print("=" * 120)
            print(
                "DRY-RUN COMPLETE"
            )
            print("=" * 120)

            print(
                f"Rules: {len(rule_rows)}"
            )

            print(
                f"Knowledge cards: "
                f"{len(card_rows)}"
            )

            print(
                "STATUS: READY FOR --apply"
            )

            print(
                f"Report: {args.report}"
            )

            return

        # ----------------------------------------------------
        # APPLY
        # ----------------------------------------------------

        backup_dir = Path(
            "/tmp/udcpr_postgres_backup"
        ) / (
            "knowledge_rebuild_"
            + datetime.now().strftime(
                "%Y%m%d_%H%M%S"
            )
        )

        backup_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        print()
        print(
            f"Backup directory: {backup_dir}"
        )

        print(
            "Backing up rules..."
        )

        rules_backup_count = backup_table(
            db,
            "rules",
            backup_dir / "rules.json",
        )

        print(
            f"  {rules_backup_count} rows"
        )

        print(
            "Backing up knowledge_cards..."
        )

        cards_backup_count = backup_table(
            db,
            "knowledge_cards",
            backup_dir / "knowledge_cards.json",
        )

        print(
            f"  {cards_backup_count} rows"
        )

        print(
            "Clearing rules..."
        )

        db.execute(
            text(
                """
                DELETE FROM public.rules
                """
            )
        )

        print(
            "Clearing knowledge_cards..."
        )

        db.execute(
            text(
                """
                DELETE FROM public.knowledge_cards
                """
            )
        )

        print(
            "Inserting canonical rules..."
        )

        insert_rules(
            db,
            rule_rows,
        )

        print(
            f"Inserted rules: {len(rule_rows)}"
        )

        print(
            "Inserting canonical knowledge cards..."
        )

        insert_cards(
            db,
            card_rows,
        )

        print(
            f"Inserted knowledge cards: "
            f"{len(card_rows)}"
        )

        print()
        print(
            "Running verification..."
        )

        verification = verify(
            db,
            len(rule_rows),
            len(card_rows),
        )

        print(
            json.dumps(
                verification,
                indent=2,
            )
        )

        report[
            "backup_directory"
        ] = str(
            backup_dir
        )

        report[
            "rules_backup_count"
        ] = rules_backup_count

        report[
            "cards_backup_count"
        ] = cards_backup_count

        report[
            "verification"
        ] = verification

        if not verification["passed"]:

            report[
                "errors"
            ] = verification[
                "failures"
            ]

            write_json(
                args.report,
                report,
            )

            db.rollback()

            print()
            print("=" * 120)
            print(
                "REBUILD ABORTED"
            )
            print("=" * 120)

            print(
                "NO DATABASE CHANGES WERE COMMITTED."
            )

            print(
                f"Report: {args.report}"
            )

            raise RuntimeError(
                "Verification failed."
            )

        db.commit()

        report[
            "committed"
        ] = True

        write_json(
            args.report,
            report,
        )

        print()
        print("=" * 120)
        print(
            "REBUILD SUCCESSFUL"
        )
        print("=" * 120)

        print(
            f"Rules inserted: "
            f"{len(rule_rows)}"
        )

        print(
            f"Knowledge cards inserted: "
            f"{len(card_rows)}"
        )

        print(
            f"Backup directory: {backup_dir}"
        )

        print(
            "PostgreSQL transaction COMMITTED."
        )

        print(
            f"Report: {args.report}"
        )

    except Exception as exc:

        try:
            db.rollback()
        except Exception:
            pass

        print()
        print("=" * 120)
        print(
            "REBUILD ABORTED"
        )
        print("=" * 120)

        print(
            "NO DATABASE CHANGES WERE COMMITTED."
        )

        print(
            f"Report: {args.report}"
        )

        print(
            f"ERROR: {exc}"
        )

        raise

    finally:

        db.close()


if __name__ == "__main__":
    main()
