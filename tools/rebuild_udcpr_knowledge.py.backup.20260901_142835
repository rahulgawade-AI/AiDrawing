# ============================================================
# BACKUP
# ============================================================

def backup_table(
    db,
    table_name,
    backup_file,
):

    if not table_exists(
        db,
        table_name,
    ):
        return 0

    rows = db.execute(
        text(
            f'''
            SELECT *
            FROM public."{table_name}"
            '''
        )
    ).mappings().all()

    write_json(
        backup_file,
        [
            dict(row)
            for row in rows
        ],
    )

    return len(rows)


