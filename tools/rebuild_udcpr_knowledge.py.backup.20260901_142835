# ============================================================

def first_sentences(
    text_value,
    maximum=3,
):

    text_value = normalize_space(
        text_value
    )

    if not text_value:
        return ""

    parts = []

    current = ""

    for char in text_value:

        current += char

        if char in ".!?":

            if len(
                current.strip()
            ) > 20:

                parts.append(
                    current.strip()
                )

                current = ""

                if len(parts) >= maximum:
                    break

    if current.strip() and len(parts) < maximum:
        parts.append(
            current.strip()
        )

    return " ".join(
        parts
    )


def make_summary(
    entry,
    source_text,
):

    number = normalize_space(
        entry.get("number")
    )

    title = normalize_space(
        entry.get("title")
    )

    excerpt = first_sentences(
        source_text,
        3,
    )

    if not excerpt:
        excerpt = (
            "Canonical source text for "
            f"UDCPR Regulation {number}."
        )

    return (
        f"UDCPR Regulation {number}: "
        f"{title}. "
        f"{excerpt}"
    )


def make_purpose(
    entry,
    source_text,
):

    number = normalize_space(
        entry.get("number")
    )

    title = normalize_space(
        entry.get("title")
    )

    return (
        f"Provides the planning and development "
        f"requirements contained in UDCPR "
        f"Regulation {number}, {title}. "
        f"The canonical source text is retained "
        f"as the authoritative basis for "
        f"planning-service interpretation."
    )


def make_scope(
    entry,
):

    number = normalize_space(
        entry.get("number")
    )

    title = normalize_space(
        entry.get("title")
    )

    return (
        f"UDCPR Regulation {number} "
        f"({title}) and its applicable "
        f"planning/development provisions."
    )


def extract_keywords(
    entry,
):

    values = []

    number = normalize_space(
        entry.get("number")
    )

    title = normalize_space(
        entry.get("title")
    )

    if number:
        values.append(
            number
        )

    if title:
        values.append(
            title
        )

    chapter = normalize_space(
        entry.get("chapter")
    )

    if chapter:
        values.append(
            "chapter " + chapter
        )

    return values


