# ============================================================
# BASIC HELPERS
# ============================================================

def normalize(value):
    if value is None:
        return ""

    return str(value).replace(
        "\r\n",
        "\n",
    ).replace(
        "\r",
        "\n",
    ).strip()


def normalize_space(value):
    return " ".join(
        normalize(value).split()
    )


def normalize_number(value):
    return normalize_space(value).replace(
        " ",
        "",
    )


def normalize_title(value):
    return normalize_space(value).lower()


def regulation_key(number, title):
    return (
        normalize_number(number)
        + "|"
        + normalize_title(title)
    )


def sha256_text(value):
    return hashlib.sha256(
        normalize(value).encode("utf-8")
    ).hexdigest()


def chunk_text(chunk):
    for field in (
        "text",
        "source_text",
        "content",
        "markdown",
    ):
        value = chunk.get(field)

        if isinstance(value, str) and value.strip():
            return normalize(value)

    return ""


def write_json(path, data):
    Path(path).write_text(
        json.dumps(
            data,
            indent=2,
            ensure_ascii=False,
            default=str,
        ),
        encoding="utf-8",
    )


# ============================================================
# LOAD JSON
# ============================================================

def load_json(path):
    with open(
        path,
        "r",
        encoding="utf-8",
    ) as f:
        return json.load(f)


def load_manifest(path):
    data = load_json(path)

    if isinstance(data, dict):
        entries = (
            data.get("regulations")
            or data.get("entries")
            or data.get("items")
            or []
        )
    else:
        entries = data

    if not isinstance(entries, list):
        raise RuntimeError(
            "Manifest does not contain a regulation list."
        )

    return entries


def load_chunks(path):
    data = load_json(path)

    if isinstance(data, dict):
        chunks = (
            data.get("chunks")
            or data.get("source_chunks")
            or data.get("items")
            or []
        )
    else:
        chunks = data

    if not isinstance(chunks, list):
        raise RuntimeError(
            "Source chunks file does not contain a list."
        )

    return chunks


# ============================================================
# BUILD CANONICAL INDEX
# ============================================================

def build_manifest_index(entries):

    result = {}

    for entry in entries:

        key = regulation_key(
            entry.get("number"),
            entry.get("title"),
        )

        if key in result:
            raise RuntimeError(
                "Duplicate manifest key: "
                + key
            )

        result[key] = entry

    return result


def build_chunk_index(chunks):

    result = defaultdict(list)

    for chunk in chunks:

        key = regulation_key(
            chunk.get("number"),
            chunk.get("title"),
        )

        result[key].append(
            chunk
        )

    return result


# ============================================================
# DATABASE INSPECTION
# ============================================================

def table_exists(db, table_name):

    inspector = inspect(
        db.bind
    )

    return inspector.has_table(
        table_name,
        schema="public",
    )


def table_count(db, table_name):

    if not table_exists(
        db,
        table_name,
    ):
        return 0

    return db.execute(
        text(
            f'''
            SELECT COUNT(*)
            FROM public."{table_name}"
            '''
        )
    ).scalar_one()


