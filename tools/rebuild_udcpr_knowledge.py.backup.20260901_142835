def select_regulations(
    db,
    manifest_by_key,
):

    rows = (
        db.query(
            RegulationModel
        )
        .all()
    )

    by_key = defaultdict(list)

    for row in rows:

        key = regulation_key(
            row.number,
            row.title,
        )

        by_key[key].append(
            row
        )

    selected = {}
    missing = []
    ambiguous = []

    for key, entry in manifest_by_key.items():

        candidates = by_key.get(
            key,
            [],
        )

        if not candidates:

            missing.append(
                {
                    "key": key,
                    "number":
                        entry.get("number"),
                    "title":
                        entry.get("title"),
                }
            )

            continue

        expected_pdf_page = (
            entry.get(
                "pdf_page_start"
            )
        )

        expected_printed_page = (
            entry.get(
                "printed_page_start"
            )
        )

        scored = []

        for row in candidates:

            score = 0

            page_start = getattr(
                row,
                "page_start",
                None,
            )

            page_end = getattr(
                row,
                "page_end",
                None,
            )

            if (
                expected_printed_page
                is not None
                and page_start
                == expected_printed_page
            ):
                score += 100

            if (
                expected_pdf_page
                is not None
                and (
                    page_start
                    == expected_pdf_page
                    or page_end
                    == expected_pdf_page
                )
            ):
                score += 50

            try:
                page = int(
                    page_start
                    or 999999
                )
            except (
                TypeError,
                ValueError,
            ):
                page = 999999

            scored.append(
                (
                    score,
                    -page,
                    str(row.id),
                    row,
                )
            )

        scored.sort(
            key=lambda x: (
                -x[0],
                -x[1],
                x[2],
            )
        )

        if (
            len(scored) > 1
            and scored[0][0] == scored[1][0]
            and scored[0][1] == scored[1][1]
        ):
            ambiguous.append(
                {
                    "key": key,
                    "number":
                        entry.get("number"),
                    "title":
                        entry.get("title"),
                    "candidate_ids":
                        [
                            x[2]
                            for x in scored
                        ],
                }
            )

            continue

        selected[key] = scored[0][3]

    return (
        selected,
        missing,
        ambiguous,
    )


# ============================================================
# SOURCE TEXT
# ============================================================

def get_source_text(
    chunk,
    entry=None,
    *args,
):
    """
    Return authoritative regulation source text.

    The canonical source file
    `udcpr_source_chunks.json` stores the actual regulation
    content in:

        chunk["regulation_text"]

    The *args parameter is intentionally accepted because older
    callers in this rebuild script pass an additional argument.

    No PostgreSQL text is used as a fallback.
    No title/heading is used as a fallback.
    """

    if not isinstance(chunk, dict):
        raise RuntimeError(
            "Invalid source chunk: expected dictionary."
        )

    source_text = chunk.get(
        "regulation_text"
    )

    if source_text is None:
        number = ""
        title = ""

        if isinstance(entry, dict):
            number = str(
                entry.get("number", "")
            ).strip()

            title = str(
                entry.get("title", "")
            ).strip()

        raise RuntimeError(
            "Missing regulation_text for "
            f"{number}|{title}".strip("|")
        )

    source_text = str(
        source_text
    ).strip()

    if not source_text:
        number = ""
        title = ""

        if isinstance(entry, dict):
            number = str(
                entry.get("number", "")
            ).strip()

            title = str(
                entry.get("title", "")
            ).strip()

        raise RuntimeError(
            "Empty regulation_text for "
            f"{number}|{title}".strip("|")
        )

    return source_text


def build_rule_rows(
    manifest_by_key,
    chunks_by_key,
    selected,
):

    rows = []

    for key, entry in (
        manifest_by_key.items()
    ):

        regulation = selected.get(
            key
        )

        if regulation is None:
            raise RuntimeError(
                "No selected regulation for "
                + key
            )

        source_text = get_source_text(
            key,
            entry,
            chunks_by_key,
        )

        regulation_id = str(
            regulation.id
        )

        number = normalize_space(
            entry.get("number")
        )

        title = normalize_space(
            entry.get("title")
        )

        page_start = (
            entry.get("pdf_page_start")
            or entry.get(
                "page_number"
            )
        )

        page_end = (
            entry.get("pdf_page_end")
            or page_start
        )

        rule_id = str(
            uuid.uuid5(
                RULE_NAMESPACE,
                "udcpr-rule:"
                + regulation_id,
            )
        )

        rows.append(
            {
                "id":
                    rule_id,

                "regulation_id":
                    regulation_id,

                "category":
                    "UDCPR",

                "name":
                    f"{number} {title}".strip(),

                "description":
                    source_text,

                "condition_json":
                    [],

                "result_json":
                    {
                        "source_text":
                            source_text,
                        "regulation":
                            number,
                        "title":
                            title,
                    },

                "priority":
                    1,

                "enabled":
                    True,

                "metadata":
                    {
                        "source":
                            "udcpr_source_chunks.json",

                        "canonical_key":
                            key,

                        "number":
                            entry.get(
                                "number"
                            ),

                        "title":
                            entry.get(
                                "title"
                            ),

                        "chapter":
                            entry.get(
                                "chapter"
                            ),

                        "pdf_page_start":
                            page_start,

                        "pdf_page_end":
                            page_end,

                        "sha256":
                            sha256_text(
                                source_text
                            ),

                        "rebuild":
                            "canonical_v2",
                    },
            }
        )

    return rows


