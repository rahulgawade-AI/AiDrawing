    summary
    purpose
    scope
    definitions
    permissions
    conditions
    prohibitions
    measurements
    exceptions
    applicability
    authority
    inputs
    outputs
    references
    related_regulations
    keywords
    examples
    notes
    metadata

DRY RUN is default.
Use --apply to commit.
"""

