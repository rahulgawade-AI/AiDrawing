def clear_tables(
    db,
):

    if table_exists(
        db,
        "knowledge_cards",
    ):

        db.execute(
            text(
                """
                DELETE FROM public.knowledge_cards
                """
            )
        )

    if table_exists(
        db,
        "rules",
    ):

        db.execute(
            text(
                """
                DELETE FROM public.rules
                """
            )
        )


