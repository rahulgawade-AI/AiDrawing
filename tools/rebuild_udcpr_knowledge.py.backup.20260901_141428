# ============================================================
# VERIFY
# ============================================================

def verify(
    db,
    expected_rules,
    expected_cards,
    canonical_regulation_ids,
):

    result = {}

    result[
        "rules"
    ] = count_table(
        db,
        "rules",
    )

    result[
        "knowledge_cards"
    ] = count_table(
        db,
        "knowledge_cards",
    )

    result[
        "expected_rules"
    ] = expected_rules

    result[
        "expected_cards"
    ] = expected_cards

    result[
        "rule_orphans"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.rules x
            LEFT JOIN public.regulations r
              ON r.id = x.regulation_id
            WHERE x.regulation_id IS NOT NULL
              AND r.id IS NULL
            """
        )
    ).scalar_one()

    result[
        "card_orphans"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.knowledge_cards x
            LEFT JOIN public.regulations r
              ON r.id = x.regulation_id
            WHERE x.regulation_id IS NOT NULL
              AND r.id IS NULL
            """
        )
    ).scalar_one()

    result[
        "canonical_rules"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.rules
            WHERE regulation_id = ANY(:ids)
            """
        ),
        {
            "ids":
                list(canonical_regulation_ids)
        },
    ).scalar_one()

    result[
        "canonical_cards"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.knowledge_cards
            WHERE regulation_id = ANY(:ids)
            """
        ),
        {
            "ids":
                list(canonical_regulation_ids)
        },
    ).scalar_one()

    result[
        "rules_without_cards"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.rules r
            WHERE r.regulation_id = ANY(:ids)
              AND NOT EXISTS (
                  SELECT 1
                  FROM public.knowledge_cards c
                  WHERE c.rule_id = r.id
              )
            """
        ),
        {
            "ids":
                list(canonical_regulation_ids)
        },
    ).scalar_one()

    result[
        "cards_without_rules"
    ] = db.execute(
        text(
            """
            SELECT COUNT(*)
            FROM public.knowledge_cards c
            WHERE c.regulation_id = ANY(:ids)
              AND NOT EXISTS (
                  SELECT 1
                  FROM public.rules r
                  WHERE r.id = c.rule_id
              )
            """
        ),
        {
            "ids":
                list(canonical_regulation_ids)
        },
    ).scalar_one()

    result[
        "passed"
    ] = (
        result["rules"]
        == expected_rules

        and
        result["knowledge_cards"]
        == expected_cards

        and
        result["canonical_rules"]
        == expected_rules

        and
        result["canonical_cards"]
        == expected_cards

        and
        result["rule_orphans"]
        == 0

        and
        result["card_orphans"]
        == 0

        and
        result["rules_without_cards"]
        == 0

        and
        result["cards_without_rules"]
        == 0
    )

    return result


# ============================================================
# MAIN
# ============================================================

def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--manifest",
        default=DEFAULT_MANIFEST,
    )

    parser.add_argument(
        "--chunks",
        default=DEFAULT_CHUNKS,
    )

    parser.add_argument(
        "--report",
        default=DEFAULT_REPORT,
    )

    parser.add_argument(
        "--apply",
        action="store_true",
    )

    args = parser.parse_args()

    print("=" * 120)
    print(
        "UDCPR RULE + KNOWLEDGE CARD CLEAN REBUILD"
    )
    print("=" * 120)

    print()

    if args.apply:

        print(
            "!!! APPLY MODE !!!"
        )

        print(
            "Existing rules and knowledge_cards "
            "will be backed up and replaced."
        )

        print(
            "regulations and tables will NOT be modified."
        )

    else:

        print(
            "DRY-RUN MODE"
        )

        print(
            "No PostgreSQL changes will be committed."
        )

    print()

    (
        manifest_by_key,
        chunks_by_key,
    ) = load_source(
        args.manifest,
        args.chunks,
    )

    source_chunk_count = sum(
        len(x)
        for x in chunks_by_key.values()
    )

    print(
        "Manifest regulations:",
        len(manifest_by_key),
    )

    print(
        "Source chunks:",
        source_chunk_count,
    )

    if len(manifest_by_key) != EXPECTED_REGULATIONS:

        raise RuntimeError(
            f"Expected {EXPECTED_REGULATIONS} "
            f"canonical regulations, got "
            f"{len(manifest_by_key)}"
        )

    if source_chunk_count != EXPECTED_REGULATIONS:

        raise RuntimeError(
            f"Expected {EXPECTED_REGULATIONS} "
            f"source chunks, got "
            f"{source_chunk_count}"
        )

    db = SessionLocal()

    try:

        print()
        print("=" * 120)
        print("DATABASE")
        print("=" * 120)

        for table in (
            "regulations",
            "tables",
            "rules",
            "knowledge_cards",
        ):

            print(
                f"{table:<20}",
                count_table(
                    db,
                    table,
                ),
            )

        (
            selected,
            missing,
            ambiguous,
        ) = select_regulations(
            db,
            manifest_by_key,
        )

        print()
        print(
            "Selected regulations:",
            len(selected),
        )

        print(
            "Missing regulations:",
            len(missing),
        )

        print(
            "Ambiguous regulations:",
            len(ambiguous),
        )

        if missing:

            raise RuntimeError(
                "Missing canonical regulations: "
                + ", ".join(
                    x["key"]
                    for x in missing[:20]
                )
            )

        # The old database contains historical duplicates.
        #
        # We intentionally do NOT abort because of them.
        # The page-aware selection above chooses one
        # canonical regulation row.

        if len(selected) != EXPECTED_REGULATIONS:

            raise RuntimeError(
                f"Expected {EXPECTED_REGULATIONS} "
                f"selected regulations, got "
                f"{len(selected)}"
            )

        # ----------------------------------------------------
        # BUILD
        # ----------------------------------------------------

        rule_rows = build_rule_rows(
            manifest_by_key,
            chunks_by_key,
            selected,
        )

        card_rows = build_card_rows(
            manifest_by_key,
            chunks_by_key,
            selected,
            rule_rows,
        )

        print()
        print(
            "Rules to rebuild:",
            len(rule_rows),
        )

        print(
            "Knowledge cards to rebuild:",
            len(card_rows),
        )

        if len(rule_rows) != EXPECTED_REGULATIONS:

            raise RuntimeError(
                f"Expected {EXPECTED_REGULATIONS} "
                f"rules, got {len(rule_rows)}"
            )

        if len(card_rows) != EXPECTED_REGULATIONS:

            raise RuntimeError(
                f"Expected {EXPECTED_REGULATIONS} "
                f"knowledge cards, got "
                f"{len(card_rows)}"
            )

        report = {
            "created_at":
                datetime.now().isoformat(),

            "mode":
                "apply"
                if args.apply
                else "dry-run",

            "manifest":
                args.manifest,

            "chunks":
                args.chunks,

            "canonical_regulations":
                len(manifest_by_key),

            "source_chunks":
                source_chunk_count,

            "selected_regulations":
                len(selected),

            "missing":
                missing,

            "ambiguous":
                ambiguous,

            "rules_to_rebuild":
                len(rule_rows),

            "knowledge_cards_to_rebuild":
                len(card_rows),
        }

        # ----------------------------------------------------
        # DRY RUN
        # ----------------------------------------------------

        if not args.apply:

            report[
                "status"
            ] = "READY_FOR_APPLY"

            write_json(
                args.report,
                report,
            )

            print()
            print("=" * 120)
            print("DRY-RUN COMPLETE")
            print("=" * 120)

            print(
                "Rules:",
                len(rule_rows),
            )

            print(
                "Knowledge cards:",
                len(card_rows),
            )

            print(
                "STATUS: READY FOR --apply"
            )

            print(
                "Report:",
                args.report,
            )

            return

        # ----------------------------------------------------
        # APPLY TRANSACTION
        # ----------------------------------------------------

        timestamp = datetime.now().strftime(
            "%Y%m%d_%H%M%S"
        )

        backup_dir = (
            Path(
                "/tmp/udcpr_postgres_backup"
            )
            /
            (
                "knowledge_rebuild_"
                + timestamp
            )
        )

        backup_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        print()
        print(
            "Backup directory:",
            backup_dir,
        )

        # ----------------------------------------------------
        # BACKUP RULES
        # ----------------------------------------------------

        old_rules_count = 0

        if table_exists(
            db,
            "rules",
        ):

            print(
                "Backing up rules..."
            )

            old_rules_count = backup_table(
                db,
                "rules",
                backup_dir
                / "rules.json",
            )

        # ----------------------------------------------------
        # BACKUP CARDS
        # ----------------------------------------------------

        old_cards_count = 0

        if table_exists(
            db,
            "knowledge_cards",
        ):

            print(
                "Backing up knowledge_cards..."
            )

            old_cards_count = backup_table(
                db,
                "knowledge_cards",
                backup_dir
                / "knowledge_cards.json",
            )

        # ----------------------------------------------------
        # ENSURE TABLES
        # ----------------------------------------------------

        ensure_rules_table(
            db
        )

        ensure_knowledge_cards_table(
            db
        )

        # ----------------------------------------------------
        # CLEAR
        # ----------------------------------------------------

        print(
            "Clearing rules..."
        )

        db.execute(
            text(
                """
                DELETE FROM public.rules
                """
            )
        )

        print(
            "Clearing knowledge_cards..."
        )

        db.execute(
            text(
                """
                DELETE FROM public.knowledge_cards
                """
            )
        )

        # ----------------------------------------------------
        # INSERT RULES
        # ----------------------------------------------------

        print(
            "Inserting canonical rules..."
        )

        insert_rules(
            db,
            rule_rows,
        )

        # ----------------------------------------------------
        # INSERT CARDS
        # ----------------------------------------------------

        print(
            "Inserting knowledge cards..."
        )

        insert_cards(
            db,
            card_rows,
        )

        # ----------------------------------------------------
        # VERIFY
        # ----------------------------------------------------

        canonical_ids = {
            str(row.id)
            for row in selected.values()
        }

        print()
        print(
            "Running verification..."
        )

        verification = verify(
            db,
            len(rule_rows),
            len(card_rows),
            canonical_ids,
        )

        print(
            json.dumps(
                verification,
                indent=2,
            )
        )

        if not verification[
            "passed"
        ]:

            raise RuntimeError(
                "Verification failed. "
                "Transaction will be rolled back."
            )

        # ----------------------------------------------------
        # COMMIT
        # ----------------------------------------------------

        db.commit()

        report[
            "status"
        ] = "SUCCESS"

        report[
            "backup_directory"
        ] = str(
            backup_dir
        )

        report[
            "old_rules_count"
        ] = old_rules_count

        report[
            "old_knowledge_cards_count"
        ] = old_cards_count

        report[
            "verification"
        ] = verification

        write_json(
            args.report,
            report,
        )

        print()
        print("=" * 120)
        print("KNOWLEDGE REBUILD SUCCESSFUL")
        print("=" * 120)

        print(
            "Rules:",
            len(rule_rows),
        )

        print(
            "Knowledge cards:",
            len(card_rows),
        )

        print(
            "Backup:",
            backup_dir,
        )

        print(
            "Report:",
            args.report,
        )

    except Exception as exc:

        db.rollback()

        report = {
            "created_at":
                datetime.now().isoformat(),

            "mode":
                "apply"
                if args.apply
                else "dry-run",

            "status":
                "ABORTED",

            "error":
                str(exc),
        }

        write_json(
            args.report,
            report,
        )

        print()
        print("=" * 120)
        print("REBUILD ABORTED")
        print("=" * 120)

        print(
            "NO COMMITTED DATABASE CHANGES."
        )

        print(
            "Report:",
            args.report,
        )

        raise

    finally:

        db.close()


if __name__ == "__main__":
    main()
