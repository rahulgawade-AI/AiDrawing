def _set_source_fact(
    facts: PlanningFacts,
    field: str,
    value: Any,
    source: str,
    conflicts: list[dict[str, Any]],
) -> None:
    if value is None or not hasattr(facts, field):
        return
    current = getattr(facts, field)
    if current is None or current == [] or current == {}:
        setattr(facts, field, value)
        facts.fact_sources[field] = source
        return
    if current != value:
        conflicts.append({
            "field": field,
            "existing": current,
            "incoming": value,
            "existing_source": facts.fact_sources.get(field, "unknown"),
            "incoming_source": source,
            "resolution": "existing authoritative source retained",
        })


def _derive_tenement_carpet_areas(user_input: dict[str, Any]) -> list[float]:
    """Derive per-tenement carpet areas from the user's unit program.

    The user input remains untouched.  We do not require a separate
    ``tenement_carpet_areas`` PlanningFacts input.  The program is expanded
    from requested_unit_mix and requested_unit_area, because the regulatory
    parking graph needs one carpet-area value per tenement.
    """
    mix = user_input.get("requested_unit_mix")
    area_map = user_input.get("requested_unit_area")

    if not isinstance(mix, list) or not mix:
        raise ValueError(
            "user_input.json must contain a non-empty requested_unit_mix list."
        )

    if not isinstance(area_map, dict) or not area_map:
        raise ValueError(
            "user_input.json must contain requested_unit_area, e.g. "
            "{\"2BHK\": 780, \"3BHK\": 1020}."
        )

    unit = str(user_input.get("tenement_carpet_area_unit", "sqft")).strip().lower()
    factors = {
        "m2": 1.0, "sqm": 1.0, "sq.m": 1.0, "sq.m.": 1.0,
        "square_meter": 1.0, "square_metre": 1.0,
        "sqft": 0.09290304, "sq.ft": 0.09290304, "sq.ft.": 0.09290304,
        "square_feet": 0.09290304, "square_foot": 0.09290304,
    }
    if unit not in factors:
        raise ValueError(
            "tenement_carpet_area_unit must be one of m2/sqm/sqft/sq.ft."
        )

    factor = factors[unit]
    result: list[float] = []

    for item in mix:
        if not isinstance(item, dict):
            raise ValueError("Each requested_unit_mix item must be an object.")

        bhk = str(item.get("type", "")).strip()
        if not bhk:
            raise ValueError("Each requested_unit_mix item requires type.")

        count = item.get("count")
        if count is None:
            raise ValueError(f"requested_unit_mix item {bhk!r} requires count.")

        try:
            count_int = int(count)
        except (TypeError, ValueError) as exc:
            raise ValueError(f"Invalid count for {bhk!r}: {count!r}") from exc

        if count_int <= 0:
            raise ValueError(f"Count for {bhk!r} must be greater than zero.")

        raw_area = area_map.get(bhk)
        if raw_area is None:
            # Accept the per-mix target only as a fallback representation of
            # the same user requirement. It is not a regulatory value.
            raw_area = item.get("target_carpet_area")

        if raw_area is None:
            raise ValueError(
                f"No requested_unit_area/target_carpet_area supplied for {bhk!r}."
            )

        try:
            area = float(raw_area)
        except (TypeError, ValueError) as exc:
            raise ValueError(
                f"Invalid requested carpet area for {bhk!r}: {raw_area!r}"
            ) from exc

        if area <= 0:
            raise ValueError(f"Requested carpet area for {bhk!r} must be > 0.")

        result.extend([area * factor] * count_int)

    requested_units = user_input.get("requested_units")
    if requested_units is not None and int(requested_units) != len(result):
        raise ValueError(
            "requested_units does not match the total count in requested_unit_mix: "
            f"requested_units={requested_units}, derived={len(result)}"
        )

    return result


def build_facts(
    user_input: dict[str, Any],
    image_facts: dict[str, Any] | None,
) -> tuple[PlanningFacts, list[dict[str, Any]], dict[str, Any]]:
    facts = PlanningFacts()
    conflicts: list[dict[str, Any]] = []
    observed: dict[str, Any] = {}

    tenement_areas = _derive_tenement_carpet_areas(user_input)

    for field, value in user_input.items():
        if field == "tenement_carpet_areas":
            continue
        _set_source_fact(facts, field, value, "user", conflicts)

    # Derived internal dependency for the parking graph. This is derived from
    # user program inputs; it is not a separate user input and is never written
    # back into user_input.json.
    if hasattr(facts, "tenement_carpet_areas"):
        facts.tenement_carpet_areas = tenement_areas
        facts.fact_sources["tenement_carpet_areas"] = "user"

    for field, value in (image_facts or {}).items():
        if value is None:
            continue
        if field in {"building_height", "number_of_floors"}:
            observed[field] = value
            continue
        if field == "boundary_present":
            if value is True and getattr(facts, "boundary", None) is None:
                facts.boundary = "image_boundary_present"
                facts.fact_sources["boundary"] = "image"
            continue
        _set_source_fact(facts, field, value, "image", conflicts)

    if getattr(facts, "road_width", None) is not None:
        facts.road_widths = [float(facts.road_width)]

    facts.normalize()
    return facts, conflicts, observed


