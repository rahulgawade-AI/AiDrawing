from __future__ import annotations

import json
import urllib.request


class OllamaClient:
    """
    Minimal Ollama HTTP client.

    Default model:
        gemma3:12b
    """

    def __init__(
        self,
        base_url: str = "http://127.0.0.1:11434",
        model: str = "gemma3:12b",
        timeout: int = 600,
    ):
        self.base_url = base_url.rstrip("/")
        self.model = model
        self.timeout = timeout

    def generate(
        self,
        prompt: str,
        *,
        temperature: float = 0.0,
    ) -> str:

        payload = {
            "model": self.model,
            "prompt": prompt,
            "stream": False,

            # Important for constraint discovery.
            "format": "json",

            "options": {
                "temperature": temperature,
            },
        }

        data = json.dumps(
            payload
        ).encode(
            "utf-8"
        )

        request = urllib.request.Request(
            f"{self.base_url}/api/generate",
            data=data,
            headers={
                "Content-Type": "application/json",
            },
            method="POST",
        )

        with urllib.request.urlopen(
            request,
            timeout=self.timeout,
        ) as response:

            body = (
                response
                .read()
                .decode("utf-8")
            )

        result = json.loads(
            body
        )

        return str(
            result.get(
                "response",
                ""
            )
        )