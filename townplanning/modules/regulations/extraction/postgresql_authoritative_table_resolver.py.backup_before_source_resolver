from __future__ import annotations

import re
from dataclasses import dataclass, field
from typing import Any

from sqlalchemy import select

from townplanning.infrastructure.database.models import (
    RegulationModel,
    Table as TableModel,
)


@dataclass(slots=True)
class SelectedTable:
    regulation_number: str
    table_number: str | None = None
    table_title: str | None = None
    source_id: str | None = None
    reason: str = ""
    deterministic: bool = True


@dataclass(slots=True)
class PostgreSQLResolution:
    status: str = "INSUFFICIENT_RULE_DATA"
    constraints: list[dict[str, Any]] = field(default_factory=list)
    missing_inputs: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)
    errors: list[str] = field(default_factory=list)
    selections: list[dict[str, Any]] = field(default_factory=list)


class PostgreSQLAuthoritativeTableResolver:
    """
    Final regulatory-value boundary.

    IMPORTANT:
      * Chroma/OpenAI are never called here.
      * Values are read directly from PostgreSQL.
      * No UDCPR numeric threshold is embedded here.
      * Table/row interpretation is generic and driven by DB content.
    """

    FIELD_ALIASES = {
        "basic_fsi": (
            "basic fsi",
            "basic permissible fsi",
        ),
        "premium_fsi": (
            "fsi on payment of premium",
            "premium fsi",
            "fsi on premium",
        ),
        "tdr_fsi": (
            "tdr fsi",
            "fsi through tdr",
            "tdr",
        ),
        "maximum_fsi": (
            "maximum building potential",
            "maximum building potential on plot",
            "maximum fsi",
            "maximum permissible fsi",
        ),
        "car_parking_required": (
            "non congested area car",
            "congested area car",
            "car parking",
            "cars required",
        ),
        "two_wheeler_parking_required": (
            "non congested area scooter",
            "congested area scooter",
            "scooter",
            "two wheeler",
            "motorcycle",
        ),
        "visitor_parking_required": (
            "visitor parking",
            "visitor",
        ),
        "parking_area_required_m2": (
            "parking area",
            "parking area required",
        ),
        "front_setback": ("front setback", "front margin"),
        "rear_setback": ("rear setback", "rear margin"),
        "side_setback": ("side setback", "side margin"),
        "side_setback_left": ("side setback", "side margin", "minimum side margins"),
        "side_setback_right": ("side setback", "side margin", "minimum side margins"),
        "maximum_height_m": (
            "maximum height",
            "maximum building height",
            "height limit",
        ),
        "maximum_storeys": (
            "maximum storeys",
            "maximum stories",
            "number of storeys",
        ),
    }

    FIELD_TABLE_HINTS = {
        "basic_fsi": ("fsi", "permissible"),
        "premium_fsi": ("fsi", "premium"),
        "tdr_fsi": ("fsi", "tdr"),
        "maximum_fsi": ("fsi", "building potential", "maximum"),
        "car_parking_required": ("parking",),
        "two_wheeler_parking_required": ("parking",),
        "visitor_parking_required": ("parking",),
        "parking_area_required_m2": ("parking",),
        "front_setback": ("setback", "margin"),
        "rear_setback": ("setback", "margin"),
        "side_setback": ("setback", "margin"),
        "maximum_height_m": ("height",),
        "maximum_storeys": ("height", "storey"),
    }

    def __init__(self, session):
        self.session = session

    # --------------------------------------------------------------
    # PUBLIC
    # --------------------------------------------------------------
    def resolve(
        self,
        *,
        facts: Any,
        selected_regulations: list[Any],
        chroma_sources: list[Any],
        requested_fields: list[str],
    ) -> PostgreSQLResolution:

        result = PostgreSQLResolution()

        numbers = []
        for value in selected_regulations or []:
            number = self._number(value)
            if number and number not in numbers:
                numbers.append(number)

        if not numbers:
            result.errors.append("No selected regulation numbers were supplied.")
            return result

        for number in numbers:
            source_texts = self._source_text_for_regulation(
                number, chroma_sources
            )

            table_refs = self._extract_table_references(source_texts)

            if not table_refs:
                # Do not invent a table. The caller can still use a source
                # that contains a direct scalar labelled provision.
                continue

            regulation = self._get_regulation(number)

            if regulation is None:
                result.errors.append(
                    f"Regulation {number} was selected but is not present in PostgreSQL."
                )
                continue

            tables = self._tables_for_regulation(number)

            for table_ref in table_refs:
                table = self._match_table(tables, table_ref)
                if table is None:
                    result.warnings.append(
                        f"PostgreSQL table {table_ref.get('table_number')} selected for regulation {number} was not found."
                    )
                    continue

                selection = SelectedTable(
                    regulation_number=number,
                    table_number=table_ref.get("table_number"),
                    table_title=table_ref.get("title"),
                    source_id=table_ref.get("source_id"),
                    reason=table_ref.get("reason", ""),
                )

                result.selections.append({
                    "regulation_number": selection.regulation_number,
                    "table_number": selection.table_number,
                    "table_title": selection.table_title,
                    "source_id": selection.source_id,
                    "reason": selection.reason,
                })

                fields = [
                    f for f in requested_fields
                    if self._table_can_supply_field(table, f)
                ]

                if not fields:
                    result.warnings.append(
                        f"PostgreSQL table {self._table_number(table) or self._table_title(table)} "
                        f"contains no requested regulatory fields for {number}."
                    )
                    continue

                resolved, missing, errors = self._resolve_table(
                    table=table,
                    facts=facts,
                    requested_fields=fields,
                    regulation_number=number,
                )

                result.constraints.extend(resolved)
                result.missing_inputs.extend(
                    x for x in missing if x not in result.missing_inputs
                )
                result.errors.extend(errors)

        if result.errors:
            result.status = "ERROR" if not result.constraints else "PARTIAL"
        elif result.constraints and result.missing_inputs:
            result.status = "PARTIAL"
        elif result.constraints:
            result.status = "RESOLVED"
        else:
            result.status = "INSUFFICIENT_RULE_DATA"

        return result

    # --------------------------------------------------------------
    # PostgreSQL lookup
    # --------------------------------------------------------------
    def _get_regulation(self, number: str):
        stmt = select(RegulationModel).where(
            RegulationModel.number == number
        )
        return self.session.scalar(stmt)

    def _tables_for_regulation(self, regulation_id: str):
        # TableModel.regulation_id may refer to an ingestion UUID rather
        # than the canonical RegulationModel UUID. Therefore first try the
        # relationship, then fall back to the complete PostgreSQL table set.

        stmt = (
            select(TableModel)
            .where(TableModel.regulation_id == regulation_id)
            .order_by(TableModel.page_number, TableModel.table_index)
        )

        tables = list(self.session.scalars(stmt))

        if tables:
            return tables

        stmt = (
            select(TableModel)
            .order_by(TableModel.page_number, TableModel.table_index)
        )

        return list(self.session.scalars(stmt))

    def _extract_table_references(cls, texts):
        """
        Extract explicit table references from Chroma-selected evidence.

        Supported UDCPR forms include:
            Table 6-D
            Table 6-G
            Table No. 6-D
            Table No.8-B
            Table 8-C
            Table 8.2-A

        The complete table identifier is preserved. Regulatory values are
        never extracted here; this method only identifies which PostgreSQL
        table must subsequently be queried.
        """
        refs = []

        for source in texts:
            text = str(source.get("text", "") or "")
            source_id = source.get("source_id")

            # Match the complete table identifier.  Do not use a trailing
            # word-boundary after the identifier because identifiers such as
            # "6-D" end with a word character but contain "-" internally.
            pattern = (
                r"\bTable\s+"
                r"(?:No\.?\s*)?"
                r"([0-9]+(?:\.[0-9]+)?(?:\s*[-–]\s*[A-Za-z0-9]+))"
                r"(?=\s|[.,;:)]+|$)"
            )

            for match in re.finditer(pattern, text, flags=re.IGNORECASE):
                table_number = (
                    re.sub(r"\s+", "", match.group(1))
                    .replace("–", "-")
                    .upper()
                )

                context = text[
                    max(0, match.start() - 180):
                    match.end() + 260
                ]

                title = cls._title_from_context(context)

                item = {
                    "table_number": table_number,
                    "title": title,
                    "source_id": source_id,
                    "reason": (
                        "Explicit table reference from "
                        "Chroma-selected regulatory evidence."
                    ),
                }

                if item not in refs:
                    refs.append(item)

        return refs

    @staticmethod
    def _title_from_context(context: str) -> str | None:
        for pattern in (
            r"Table\s+(?:No\.?\s*)?[0-9]+(?:\.[0-9]+)?[-A-Za-z]?\s*[:\-]\s*([^\n]+)",
            r"Table\s+(?:No\.?\s*)?[0-9]+(?:\.[0-9]+)?[-A-Za-z]?\s*\n\s*([^\n]+)",
        ):
            m = re.search(pattern, context, re.I)
            if m:
                title = m.group(1).strip(" .:-")
                if title:
                    return title[:180]
        return None

    def _match_table(self, tables, ref):
        """
        Match the Chroma-selected table against actual populated PostgreSQL
        TableModel records.

        TableModel.title is often empty because of PDF ingestion. Therefore
        table identity is recovered from markdown/headers/metadata.

        Empty records are never selected.
        """
        wanted = self._norm_table(ref.get("table_number"))

        if not wanted:
            return None

        candidates = []

        for table in tables or []:
            rows = getattr(table, "rows", None) or []

            # Never use an empty PostgreSQL record as the authoritative table.
            if not rows:
                continue

            metadata = (
                getattr(table, "extra_metadata", None)
                or getattr(table, "metadata", None)
                or {}
            )

            values = [
                getattr(table, "title", "") or "",
                getattr(table, "markdown", "") or "",
                getattr(table, "headers", "") or "",
                metadata,
            ]

            table_number = None

            # First check explicit metadata.
            if isinstance(metadata, dict):
                table_number = (
                    metadata.get("table_number")
                    or metadata.get("table_no")
                    or metadata.get("table")
                    or metadata.get("number")
                )

            if table_number:
                if self._norm_table(table_number) == wanted:
                    candidates.append(table)
                    continue

            # Then recover table number from actual PostgreSQL table text.
            text = "\n".join(str(v) for v in values)

            patterns = (
                r"\btable\s+(?:no\.?\s*)?"
                r"([0-9]+(?:\.[0-9]+)?\s*[-–]\s*[A-Za-z0-9]+)\b",
                r"\btable\s+(?:no\.?\s*)?"
                r"([0-9]+\s*[-–]\s*[A-Za-z0-9]+)\b",
            )

            found = None

            for pattern in patterns:
                match = re.search(pattern, text, re.I)
                if match:
                    found = match.group(1)
                    break

            if found and self._norm_table(found) == wanted:
                candidates.append(table)

        if not candidates:
            return None

        # If duplicate populated records exist, choose the richest one.
        candidates.sort(
            key=lambda t: (
                len(getattr(t, "rows", None) or []),
                len(getattr(t, "headers", None) or []),
                len(getattr(t, "markdown", None) or ""),
            ),
            reverse=True,
        )

        return candidates[0]

    def _resolve_table(
        self,
        *,
        table,
        facts,
        requested_fields,
        regulation_number,
    ):
        rows = list(getattr(table, "rows", None) or [])
        headers = list(getattr(table, "headers", None) or [])

        if not rows:
            return [], [], [
                f"PostgreSQL table "
                f"{self._table_number(table) or self._table_title(table)} "
                f"has no rows."
            ]

        normalized_headers = self._normalize_headers(headers, rows)

        applicable = []
        missing = []

        for index, raw_row in enumerate(rows):
            row = self._row_dict(raw_row, normalized_headers)

            row_missing = self._missing_inputs(row, facts)

            for item in row_missing:
                if item not in missing:
                    missing.append(item)

            if self._row_applies(row, facts, headers):
                applicable.append((index, row))

        if not applicable:
            if missing:
                return [], missing, []

            return [], [], [
                "No PostgreSQL row matched PlanningFacts in table "
                f"{self._table_number(table) or self._table_title(table)}."
            ]

        # Multiple applicable rows are acceptable only when they provide
        # identical requested values. Never choose between conflicting
        # regulatory rows arbitrarily.
        if len(applicable) > 1:
            candidate_values = []

            for index, row in applicable:
                values = self._extract_fields(
                    row,
                    requested_fields,
                    facts,
                )
                candidate_values.append((index, values))

            merged = {}

            for _, values in candidate_values:
                for field, value in values.items():
                    merged.setdefault(field, set()).add(
                        self._stable(value)
                    )

            conflicts = [
                field
                for field, values in merged.items()
                if len(values) > 1
            ]

            if conflicts:
                return [], [], [
                    "Multiple PostgreSQL rows matched with conflicting "
                    f"values for: {', '.join(conflicts)}."
                ]

        selected_index, selected_row = applicable[0]

        values = self._extract_fields(
            selected_row,
            requested_fields,
            facts,
        )

        constraints = []

        for field, value in values.items():
            constraints.append({
                "field": field,
                "value": value,
                "unit": "fsi" if field.endswith("_fsi") else None,
                "source_id": (
                    "postgresql:table:"
                    f"{getattr(table, 'id', 'unknown')}"
                    f":row:{selected_index}"
                ),
                "regulation_number": regulation_number,
                "table_number": self._table_number(table),
                "table_title": self._table_title(table),
                "row_index": selected_index,
                "confidence": "authoritative",
            })

        return constraints, missing, []

    def _extract_fields(self, row, requested_fields, facts):
        result = {}

        for field in requested_fields:
            candidates = self.FIELD_ALIASES.get(field, ())
            key = self._find_column(row, candidates)

            if key is None:
                continue

            value = self._parse_scalar(row[key])

            if value is not None:
                result[field] = value

        return result

    def _table_can_supply_field(self, table, field):
        text = re.sub(
            r"\s+",
            " ",
            " ".join(
                str(x) for x in (
                    getattr(table, "title", ""),
                    getattr(table, "headers", ""),
                    getattr(table, "markdown", ""),
                )
            ),
        ).lower()

        hints = self.FIELD_TABLE_HINTS.get(field, ())
        return not hints or any(h in text for h in hints)

    # --------------------------------------------------------------
    # Generic row matching
    # --------------------------------------------------------------
    def _row_applies(self, row, facts, headers=None):
        """
        Deterministically select the applicable PostgreSQL table row.

        The row dictionary alone is insufficient for PDF-extracted tables
        because the meaningful dimension may be represented by positional
        columns. Therefore headers are used to identify the road-width
        dimension.
        """

        if not isinstance(row, dict):
            return True

        # PlanningFacts -> plain dictionary
        fact_values = {}

        if facts is not None:
            if hasattr(facts, "model_dump"):
                try:
                    fact_values = facts.model_dump()
                except Exception:
                    fact_values = {}

            if not fact_values and hasattr(facts, "__dict__"):
                fact_values = dict(facts.__dict__)

        fact_road_width = (
            fact_values.get("road_width")
            if fact_values.get("road_width") is not None
            else fact_values.get("road_width_m")
        )

        try:
            fact_road_width = float(fact_road_width)
        except (TypeError, ValueError):
            fact_road_width = None

        # ------------------------------------------------------------
        # Build header -> row-value pairs.
        # ------------------------------------------------------------

        pairs = []

        if headers:
            # _normalize_headers() may return a flat list.
            normalized_headers = self._normalize_headers(headers)

            row_values = list(row.values())

            for index, header in enumerate(normalized_headers):
                if index < len(row_values):
                    pairs.append(
                        (
                            str(header or ""),
                            row_values[index],
                        )
                    )

        # Also inspect the dictionary's own keys.
        for key, value in row.items():
            pairs.append((str(key), value))

        # ------------------------------------------------------------
        # ROAD WIDTH
        # ------------------------------------------------------------

        if fact_road_width is not None:

            for header, value in pairs:

                nh = self._norm(header)

                if (
                    "road width" not in nh
                    and "width of road" not in nh
                    and "roadside width" not in nh
                ):
                    continue

                if value in (
                    None,
                    "",
                    "--",
                    "-",
                    "NA",
                    "N/A",
                ):
                    continue

                text = (
                    str(value)
                    .replace("–", "-")
                    .replace("—", "-")
                    .replace("−", "-")
                )

                numbers = [
                    float(x)
                    for x in re.findall(
                        r"(?<![A-Za-z])\d+(?:\.\d+)?",
                        text,
                    )
                ]

                lower = None
                upper = None

                # Above X
                m = re.search(
                    r"(?:above|more\s+than|greater\s+than|over)\s*"
                    r"(\d+(?:\.\d+)?)",
                    text,
                    re.I,
                )

                if m:
                    lower = float(m.group(1))

                # Below X / upto X
                m = re.search(
                    r"(?:below|less\s+than|under|upto|up\s+to)\s*"
                    r"(\d+(?:\.\d+)?)",
                    text,
                    re.I,
                )

                if m:
                    upper = float(m.group(1))

                # Two-number interval.
                if len(numbers) >= 2:
                    if lower is None:
                        lower = numbers[0]
                    if upper is None:
                        upper = numbers[1]

                # Below X
                if upper is not None and lower is None:
                    return fact_road_width < upper

                # Above X
                if lower is not None and upper is None:
                    return fact_road_width >= lower

                # X <= road width < Y
                if lower is not None and upper is not None:
                    return (
                        fact_road_width >= lower
                        and fact_road_width < upper
                    )

                # Exact numeric condition.
                if len(numbers) == 1:
                    return abs(
                        fact_road_width - numbers[0]
                    ) < 1e-9

        # ------------------------------------------------------------
        # No dimensional condition was found.
        #
        # Such a row may be a common/header/informational row and is
        # allowed to proceed to field extraction.
        # ------------------------------------------------------------

        return True


    def _looks_like_authority_cell(value):
        return any(
            token in value
            for token in (
                "municipal",
                "corporation",
                "authority",
                "cidco",
                "pcntda",
            )
        )

    @staticmethod
    def _authority_matches(cell, authority):
        # Generic token matching; no authority-specific regulatory values.
        a_tokens = {
            x for x in re.split(r"[^a-z0-9]+", authority)
            if len(x) >= 3
        }
        c_tokens = {
            x for x in re.split(r"[^a-z0-9]+", cell)
            if len(x) >= 3
        }
        return bool(a_tokens & c_tokens)

    @staticmethod
    def _matches_range(text, number):
        t = text.lower().replace("–", "-").replace("—", "-")

        nums = [
            float(x)
            for x in re.findall(r"\d+(?:\.\d+)?", t)
        ]

        if not nums:
            return True

        lower = upper = None

        if re.search(r"\bbelow\b|\bunder\b|<", t):
            upper = nums[-1]
        elif re.search(r"\babove\b|\bmore than\b|>", t):
            lower = nums[0]

        if len(nums) >= 2:
            if re.search(
                r"and\s+above.*(?:below|upto|up to|less)|to\s*<|[-]\s*<",
                t,
            ):
                lower, upper = nums[0], nums[1]
            elif "upto" in t or "up to" in t or "to" in t:
                lower, upper = nums[0], nums[1]

        if lower is not None and number < lower:
            return False
        if upper is not None and number >= upper:
            return False

        return True

    # --------------------------------------------------------------
    # Missing input detection
    # --------------------------------------------------------------
    def _missing_inputs(self, row, facts):
        missing = []

        if self._find_column(
            row, ("road width", "road width in meters", "width of road")
        ) is not None:
            if self._fact(facts, "road_width") is None:
                missing.append("road_width")

        if self._find_column(
            row, ("plot area", "area of plot", "plot size")
        ) is not None:
            if self._fact(facts, "plot_area") is None:
                missing.append("plot_area")

        if self._find_column(
            row, ("carpet area", "size of tenement", "tenement area")
        ) is not None:
            areas = self._fact(facts, "tenement_carpet_areas")
            if not areas:
                missing.append("tenement_carpet_areas")

        if self._find_column(
            row, ("height", "building height")
        ) is not None:
            if self._fact(facts, "building_height") is None:
                missing.append("building_height")

        return missing

    # --------------------------------------------------------------
    # Helpers
    # --------------------------------------------------------------
    @staticmethod
    def _fact(facts, name):
        if hasattr(facts, "get"):
            return facts.get(name)
        return getattr(facts, name, None)

    @staticmethod
    def _number(value):
        if isinstance(value, dict):
            value = (
                value.get("regulation_number")
                or value.get("number")
                or value.get("regulation")
            )
        else:
            value = (
                getattr(value, "regulation_number", None)
                or getattr(value, "number", None)
                or value
            )

        if value is None:
            return None

        text = str(value).strip()
        if text.upper().startswith("UDCPR:"):
            text = text.split(":", 1)[1].strip()

        return text.split("|", 1)[0].strip() or None

    @staticmethod
    def _source_text_for_regulation(number, sources):
        result = []
        for source in sources or []:
            metadata = getattr(source, "metadata", {}) or {}
            source_number = (
                metadata.get("regulation_number")
                or metadata.get("number")
                or getattr(source, "regulation_number", None)
            )

            if source_number is not None:
                source_number = str(source_number).strip()

            text = (
                getattr(source, "text", None)
                or getattr(source, "content", None)
                or ""
            )

            if (source_number and PostgreSQLAuthoritativeTableResolver._norm(source_number) == PostgreSQLAuthoritativeTableResolver._norm(number)) or PostgreSQLAuthoritativeTableResolver._norm(number) in PostgreSQLAuthoritativeTableResolver._norm(text):
                result.append({
                    "source_id": (
                        getattr(source, "source_id", None)
                        or getattr(source, "id", None)
                        or "chroma-source"
                    ),
                    "text": str(text),
                })

        return result

    @staticmethod
    def _table_number(text):
        """
        Extract the complete UDCPR table identifier.

        Examples:
            Table 6-D      -> 6-D
            Table No. 6-D  -> 6-D
            Table 6-G      -> 6-G
            Table No.8-B   -> 8-B
            Table 8-C      -> 8-C
        """
        import re

        if not text:
            return None

        value = str(text)

        patterns = (
            r"\btable\s*(?:no\.?\s*)?([0-9]+\s*[-–]\s*[A-Za-z0-9]+)\b",
            r"\btable\s*(?:no\.?\s*)?([0-9]+\s*[A-Za-z])\b",
        )

        for pattern in patterns:
            match = re.search(pattern, value, flags=re.IGNORECASE)
            if match:
                return (
                    re.sub(r"\s+", "", match.group(1))
                    .replace("–", "-")
                    .upper()
                )

        return None

    @staticmethod
    def _table_title(table):
        return str(getattr(table, "title", "") or "").strip()

    @staticmethod
    def _norm_table(value):
        return re.sub(
            r"[^0-9a-z]+", "", str(value or "").lower()
        )

    @staticmethod
    def _norm(value):
        return re.sub(
            r"\s+", " ", str(value or "").strip().lower()
        )

    @staticmethod
    def _normalize_headers(headers, rows):
        """
        Reconstruct sparse/multi-row PDF table headers.

        The UDCPR tables are often stored as a first header row plus several
        continuation rows. We concatenate non-empty cells by column until the
        row containing simple numeric column numbers is reached.

        This is structural parsing only; it does not contain regulatory values.
        """
        width = 0
        if headers:
            if any(isinstance(item, (list, tuple, dict)) for item in headers):
                for item in headers:
                    width = max(width, len(item) if isinstance(item, (list, tuple, dict)) else 1)
            else:
                width = len(headers)
        for row in rows:
            if isinstance(row, (list, tuple)):
                width = max(width, len(row))
            elif isinstance(row, dict):
                width = max(width, len(row))

        if width == 0:
            return []

        header_rows = []
        if headers:
            # PostgreSQL table ingestion may store headers as a list of
            # header rows (the PDF extractor preserves merged/multi-row
            # headers).  Treat nested headers as rows; a flat header list is
            # one row.
            if any(isinstance(item, (list, tuple, dict)) for item in headers):
                for item in headers:
                    if isinstance(item, dict):
                        header_rows.append(list(item.values()))
                    elif isinstance(item, (list, tuple)):
                        header_rows.append(list(item))
                    else:
                        header_rows.append([item])
            else:
                header_rows.append(list(headers))

        # Some ingestion versions put the real multi-row headers in rows.
        # Collect leading rows until the first obvious data row.
        for raw in rows[:8]:
            if isinstance(raw, dict):
                values = list(raw.values())
            else:
                values = list(raw or [])

            joined = " ".join(str(v or "") for v in values).strip()
            if not joined:
                continue

            numeric_only = (
                sum(
                    1 for v in values
                    if str(v or "").strip().isdigit()
                ) >= 3
            )

            has_data_row = bool(
                re.search(
                    r"\b(?:below|above|upto|up to|and above)\b",
                    joined,
                    re.I,
                )
            )

            if numeric_only or has_data_row:
                break

            header_rows.append(values)

        result = []
        for col in range(width):
            parts = []
            for row in header_rows:
                if col >= len(row):
                    continue
                value = str(row[col] or "").strip()
                if not value:
                    continue
                if value.isdigit():
                    continue
                if value not in parts:
                    parts.append(value)

            result.append(" ".join(parts).strip() or f"column_{col}")

        return result

    @staticmethod
    def _row_dict(raw_row, headers):
        if isinstance(raw_row, dict):
            return {
                str(k).strip(): v
                for k, v in raw_row.items()
            }

        values = list(raw_row or [])
        return {
            headers[i] if i < len(headers) else f"column_{i}": value
            for i, value in enumerate(values)
        }

    @classmethod
    def _find_column(cls, row, aliases):
        normalized = {
            cls._norm(k): k
            for k in row
        }

        for alias in aliases:
            needle = cls._norm(alias)
            if needle in normalized:
                return normalized[needle]

        for alias in aliases:
            needle = cls._norm(alias)
            for key_norm, key in normalized.items():
                if needle and needle in key_norm:
                    return key

        return None

    @staticmethod
    def _parse_scalar(raw):
        if raw is None:
            return None

        text = str(raw).strip()
        if not text or text in {"-", "--", "N/A", "NA"}:
            return None

        m = re.fullmatch(
            r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)"
            r"(?:\s*(mm|cm|m|ft|feet|%|sq\.?\s*m|sqm|fsi))?",
            text,
            re.I,
        )
        if not m:
            return None

        value = float(re.match(
            r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)",
            text,
        ).group(0))

        unit = (m.group(1) or "").lower()

        if unit == "mm":
            value /= 1000.0
        elif unit == "cm":
            value /= 100.0
        elif unit in {"ft", "feet"}:
            value *= 0.3048

        return int(value) if value.is_integer() else value

    @staticmethod
    def _stable(value):
        return repr(value)
