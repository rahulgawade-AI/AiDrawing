from __future__ import annotations

import re
from dataclasses import dataclass, field
from typing import Any, Mapping

from sqlalchemy import select

from townplanning.infrastructure.database.models import Table as TableModel


# ============================================================================
# DATA MODELS
# ============================================================================

@dataclass(slots=True)
class SelectedTable:
    """
    Explicit table selected from the Chroma regulatory source.

    Chroma determines WHICH table is applicable.
    PostgreSQL supplies the authoritative table contents.
    """

    regulation_number: str
    table_number: str
    table_title: str = ""
    table: Any | None = None
    reason: str = ""
    source_text: str = ""


@dataclass(slots=True)
class PostgreSQLConstraint:
    key: str
    value: Any
    unit: str | None = None

    source_rule_id: str = ""
    regulation_id: str = ""
    rule_name: str = ""
    category: str = "regulatory"
    priority: int = 1

    status: str = "verified"
    reason: str = ""

    metadata: dict[str, Any] = field(
        default_factory=dict
    )


@dataclass(slots=True)
class PostgreSQLResolution:
    constraints: list[PostgreSQLConstraint] = field(
        default_factory=list
    )

    warnings: list[str] = field(
        default_factory=list
    )

    errors: list[str] = field(
        default_factory=list
    )

    missing_inputs: list[str] = field(
        default_factory=list
    )

    selections: list[SelectedTable] = field(
        default_factory=list
    )

    status: str = "INSUFFICIENT_RULE_DATA"


