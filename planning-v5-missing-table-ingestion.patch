+    # ---------------------------------------------------------
+    def find_by_page_and_title(
+        self,
+        page: int,
+        title_contains: str | None = None,
+    ):
+        """
+        Find an existing structured table.
+
+        The repository only reads PostgreSQL. It never invokes
+        PDF extraction.
+        """
+        stmt = (
+            select(TableModel)
+            .where(
+                TableModel.page_number == page
+            )
+            .order_by(
+                TableModel.table_index
+            )
+        )
+
+        models = list(
+            self.session.scalars(stmt)
+        )
+
+        if not title_contains:
+            return (
+                TableMapper.to_domain(models[0])
+                if models
+                else None
+            )
+
+        needle = title_contains.lower()
+
+        for model in models:
+            title = str(
+                model.title or ""
+            ).lower()
+
+            headers = " ".join(
+                str(value)
+                for value in (model.headers or [])
+                if value is not None
+            ).lower()
+
+            if (
+                needle in title
+                or needle in headers
+            ):
+                return TableMapper.to_domain(model)
+
+        return None
+
