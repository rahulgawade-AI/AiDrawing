+    # --------------------------------------------------
+    # Structured UDCPR table resolution
+    # --------------------------------------------------
+    def get_or_ingest_table(
+        self,
+        page_number: int,
+        title_contains: str | None = None,
+        pdf_path: str | None = None,
+    ):
+        """
+        Return an existing structured UDCPR table.
+
+        If the table is missing from PostgreSQL, reuse the existing
+        TableExtractor through IngestionService, persist the result
+        into the existing `tables` table, and return it.
+
+        No new database table is created.
+        """
+        session = self.session_factory()
+
+        try:
+            repository = SQLAlchemyTableRepository(
+                session
+            )
+
+            existing = (
+                repository.find_by_page_and_title(
+                    page_number,
+                    title_contains,
+                )
+            )
+
+            if existing is not None:
+                return existing
+
+            source = (
+                pdf_path
+                or os.getenv("UDCPR_PDF_PATH")
+                or "/home/ubuntu/llmproject/udcpr_ai/app/services/UDCPR.pdf"
+            )
+
+            if not os.path.isfile(source):
+                raise FileNotFoundError(
+                    "UDCPR PDF not found. Set UDCPR_PDF_PATH. "
+                    f"Path: {source}"
+                )
+
+            tables = (
+                self.ingestion_service.extract_tables(
+                    source,
+                    page_number,
+                )
+            )
+
+            if not tables:
+                return None
+
+            selected = None
+
+            if title_contains:
+                needle = title_contains.lower()
+
+                for table in tables:
+                    header_text = " ".join(
+                        str(value)
+                        for value in (table.headers or [])
+                        if value is not None
+                    ).lower()
+
+                    if needle in header_text:
+                        selected = table
+                        break
+
+            if selected is None:
+                selected = tables[0]
+
+            # Find the already-ingested Regulation that owns this
+            # PDF page. We do NOT create a new Regulation merely
+            # because a structured table is missing.
+            regulation = (
+                session.query(RegulationModel)
+                .filter(
+                    RegulationModel.page_start <= page_number,
+                    RegulationModel.page_end >= page_number,
+                )
+                .order_by(
+                    RegulationModel.page_start.desc()
+                )
+                .first()
+            )
+
+            if regulation is None:
+                raise RuntimeError(
+                    "Cannot persist extracted table: no existing "
+                    f"Regulation covers PDF page {page_number}."
+                )
+
+            persistence = PersistenceService(
+                session
+            )
+
+            persistence.persist_tables(
+                [selected],
+                regulation.id,
+            )
+
+            # Read it back from PostgreSQL so the caller always gets
+            # the canonical persisted representation.
+            return repository.find_by_page_and_title(
+                page_number,
+                title_contains,
+            )
+
+        finally:
+            session.close()
