class ConstraintCalculator:
    """
    Converts applicable UDCPR rules into PlanningConstraints.

    This class does NOT decide whether a rule applies.
    Rule applicability is handled by the rule engine/resolver.

    Responsibilities:
        - read applicable rule results
        - populate regulatory constraints
        - calculate derived values such as maximum built-up area
        - preserve rule traceability
        - never invent unsupported regulatory values
    """
    def __init__(
        self,
        table_repository=None,
    ):
        self.table_repository = table_repository
        self.table_parking_calculator = TableParkingCalculator()

    def calculate(
        self,
        facts: PlanningFacts,
        rules: list[ApplicableRule],
    ) -> PlanningConstraints:

        constraints = PlanningConstraints()

        applicable = [
            rule
            for rule in rules
            if getattr(rule, "status", None) == "applicable"
            ]

        unresolved = [
            rule
            for rule in rules
            if getattr(rule, "status", None) == "unresolved"
        ]

        rejected = [
            rule
            for rule in rules
            if getattr(rule, "status", None)
            in {
                "not_applicable",
                "invalid",
            }
        ]

        constraints.applied_rules = applicable
        constraints.unresolved_rules = unresolved
        constraints.rejected_rules = rejected

        # Preserve non-numeric regulatory instructions and references.
        # These are intentionally metadata rather than fabricated numeric
        # constraints.  The same existing PlanningConstraints object remains
        # the public contract.
        requirements = []
        for rule in applicable:
            result = rule.result or {}
            action = result.get("action")
            if action or result.get("input_tables") or result.get("references"):
                requirements.append({
                    "rule_id": getattr(rule, "rule_id", None),
                    "name": getattr(rule, "name", None),
                    "category": getattr(rule, "category", None),
                    "action": action,
                    "result": result,
                })
        constraints.metadata["regulatory_requirements"] = requirements

        # --------------------------------------------------
        # Apply individual rules
        # --------------------------------------------------

        for rule in applicable:
            self._apply_rule(
                constraints=constraints,
                rule=rule,
            )

        # --------------------------------------------------
        # Table-driven parking calculation
        # --------------------------------------------------

        # self._apply_table_parking(
        #     facts=facts,
        #     constraints=constraints,
        # )

        # --------------------------------------------------
        # Derived calculations
        # --------------------------------------------------

        self._calculate_fsi(
            facts=facts,
            constraints=constraints,
        )

        self._calculate_built_up_area(
            facts=facts,
            constraints=constraints,
        )

        self._calculate_height(
            facts=facts,
            constraints=constraints,
        )
        self._apply_table_parking(
            constraints=constraints,
            facts=facts,
        )

        # --------------------------------------------------
        # Audit
        # --------------------------------------------------

        constraints.metadata.update(
            {
                "plot_area": facts.plot_area,
                "road_width": facts.road_width,
                "building_type": facts.building_type,
                "building_use": facts.building_use,
                "rule_count": len(rules),
                "applicable_rule_count": len(applicable),
                "unresolved_rule_count": len(unresolved),
            }
        )

        return constraints


        # ======================================================
    # TABLE-DRIVEN PARKING
    # ======================================================

    def _apply_table_parking(
        self,
        facts: PlanningFacts,
        constraints: PlanningConstraints,
    ) -> None:

        # Table repository is optional so the existing
        # ConstraintCalculator remains usable without DB
        # table access.

        if self.table_repository is None:
            return

        try:
            table = None

            # Prefer repository lookup by page because
            # Table No.8-B is persisted on PDF page 165.
            tables = self.table_repository.list_by_page(165)

            for candidate in tables:

                headers = (
                    getattr(candidate, "headers", None)
                    or []
                )

                title = (
                    getattr(candidate, "title", None)
                    or ""
                )

                header_text = " ".join(
                    str(value)
                    for value in headers
                )

                searchable = (
                    f"{title} {header_text}"
                ).lower()

                if (
                    "table no.8-b" in searchable
                    or "parking requirements" in searchable
                ):
                    table = candidate
                    break

            if table is None:
                constraints.metadata[
                    "parking_table_result"
                ] = {
                    "status": "table_not_found",
                    "table": "Table No.8-B",
                    "page": 165,
                }
                return

            result = (
                self.table_parking_calculator.calculate(
                    table,
                    facts,
                )
            )

            # Always preserve the complete table calculation
            # for traceability.
            constraints.metadata[
                "parking_table_result"
            ] = result

            if not isinstance(result, dict):
                return

            if result.get("status") != "calculated":
                return

            car = result.get(
                "car_parking_required"
            )

            two_wheeler = result.get(
                "two_wheeler_parking_required"
            )

            visitor = result.get(
                "visitor_parking_required"
            )

            if car is not None:
                constraints.car_parking_required = car

            if two_wheeler is not None:
                constraints.two_wheeler_parking_required = (
                    two_wheeler
                )

            if visitor is not None:
                constraints.visitor_parking_required = (
                    visitor
                )

        except Exception as exc:

            # Do not break the complete constraint calculation
            # because table lookup/calculation failed.

            constraints.metadata[
                "parking_table_result"
            ] = {
                "status": "error",
                "table": "Table No.8-B",
                "page": 165,
                "error": str(exc),
            }

    # ======================================================
    # RULE APPLICATION
    # ======================================================

    def _apply_rule(
        self,
        constraints: PlanningConstraints,
        rule: ApplicableRule,
    ) -> None:

        category = (
            rule.category or ""
        ).strip().lower()

        name = (
            rule.name or ""
        ).strip().lower()

        result = rule.result or {}

        # --------------------------------------------------
        # Land use
        # --------------------------------------------------

        self._apply_land_use(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # FSI
        # --------------------------------------------------

        self._apply_fsi(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Setbacks / coverage
        # --------------------------------------------------

        self._apply_setbacks(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Height
        # --------------------------------------------------

        self._apply_height(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Parking
        # --------------------------------------------------

        self._apply_parking(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Fire
        # --------------------------------------------------

        self._apply_fire(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Circulation
        # --------------------------------------------------

        self._apply_circulation(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Accessibility
        # --------------------------------------------------

        self._apply_accessibility(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Open spaces
        # --------------------------------------------------

        self._apply_open_spaces(
            constraints,
            category,
            name,
            result,
        )

        # --------------------------------------------------
        # Special conditions
        # --------------------------------------------------

        self._apply_special_conditions(
            constraints,
            category,
            name,
            result,
        )

    # ======================================================
    # LAND USE
    # ======================================================

    def _apply_land_use(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        if category == "building type":
            permitted = self._list_value(
                result,
                "permitted_uses",
                "uses",
                "permittedUses",
            )

            if permitted:
                for use in permitted:
                    if use not in constraints.permitted_uses:
                        constraints.permitted_uses.append(
                            str(use)
                        )

        if (
            "mixed use" in name
            or "mixed use" in category
        ):
            value = self._bool_value(
                result,
                "allowed",
                "permitted",
                "mixed_use_allowed",
            )

            if value is not None:
                constraints.mixed_use_allowed = value

    # ======================================================
    # FSI
    # ======================================================

    def _apply_fsi(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        basic = self._number_value(
            result,
            "basic_fsi",
            "basicFSI",
            "fsi",
            "permissible_fsi",
            "permissibleFSI",
        )

        premium = self._number_value(
            result,
            "premium_fsi",
            "premiumFSI",
            "additional_fsi",
            "premium",
        )

        tdr = self._number_value(
            result,
            "tdr_fsi",
            "tdrFSI",
            "tdr",
        )

        incentive = self._number_value(
            result,
            "incentive_fsi",
            "incentiveFSI",
            "incentive",
        )

        maximum = self._number_value(
            result,
                 "maximum_fsi",
                 "maximumFSI",
                 "max_fsi",
                 "maxFSI",
            "maximum_building_potential",
            "maximumBuildingPotential",
            "maximum_potential",
            "maximumPotential",
            "maximum_permissible_fsi",
            "maximumPermissibleFSI",
            "maximum_total_fsi",
            "maximumTotalFSI",
            "max_total_fsi",
        )

        total = self._number_value(
            result,
            "total_fsi",
            "totalFSI",
        )

        if basic is not None:
            constraints.basic_fsi = self._max_or_set(
                constraints.basic_fsi,
                basic,
            )

        if premium is not None:
            constraints.premium_fsi = self._max_or_set(
                constraints.premium_fsi,
                premium,
            )

        if tdr is not None:
            constraints.tdr_fsi = self._max_or_set(
                constraints.tdr_fsi,
                tdr,
            )

        if incentive is not None:
            constraints.incentive_fsi = self._max_or_set(
                constraints.incentive_fsi,
                incentive,
            )

        if maximum is not None:
            constraints.maximum_fsi = self._min_or_set(
                constraints.maximum_fsi,
                maximum,
            )

        if total is not None:
            constraints.total_fsi = self._min_or_set(
                constraints.total_fsi,
                total,
            )

        # Some UDCPR rules do not put a numeric premium value directly in
        # result_json.  Instead they explicitly say that premium FSI is the
        # difference between the already-calculated FSI and the applicable
        # maximum building potential.  The rule must be applicable before
        # this calculation is allowed.
        if (
            "premium for additional fsi" in name
            and str(result.get("action", "")).strip().lower()
            in {"pay_premium", "calculate premium"}
            and constraints.maximum_fsi is not None
        ):
            base_fsi = sum(
                value
                for value in (
                    constraints.basic_fsi,
                    constraints.tdr_fsi,
                    constraints.incentive_fsi,
                )
                if value is not None
            )
            available_premium = max(
                0.0,
                constraints.maximum_fsi - base_fsi,
            )
            if available_premium > 0:
                constraints.premium_fsi = self._max_or_set(
                    constraints.premium_fsi,
                    available_premium,
                )

    # ======================================================
    # SETBACKS / COVERAGE
    # ======================================================

    def _apply_setbacks(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        front = self._number_value(
            result,
            "front_setback",
            "frontMargin",
            "front_margin",
            "minimum_front_margin",
            "setback_front",
        )

        rear = self._number_value(
            result,
            "rear_setback",
            "rearMargin",
            "rear_margin",
            "minimum_rear_margin",
        )

        side = self._number_value(
            result,
            "side_setback",
            "sideMargin",
            "side_margin",
            "minimum_side_margin",
        )

        # Road-setback rules often use a generic ``setbackDistance`` key.
        # Treat it as a front/road margin because the rule itself is a road
        # setback.  This remains deterministic and does not invent a rear
        # or side setback.
        road_setback = self._number_value(
            result,
            "setbackDistance",
            "setback_distance_meters",
            "distance_meters",
        )
        if road_setback is not None and front is None:
            front = road_setback

        left = self._number_value(
            result,
            "side_setback_left",
            "left_side_margin",
        )

        right = self._number_value(
            result,
            "side_setback_right",
            "right_side_margin",
        )

        coverage = self._number_value(
            result,
            "maximum_ground_coverage",
            "ground_coverage",
            "maximum_coverage",
            "coverage",
        )

        open_space = self._number_value(
            result,
            "minimum_open_space",
            "minimum_open_space_m2",
        )

        if front is not None:
            constraints.front_setback = self._max_or_set(
                constraints.front_setback,
                front,
            )

        if rear is not None:
            constraints.rear_setback = self._max_or_set(
                constraints.rear_setback,
                rear,
            )

        if side is not None:
            constraints.side_setback_left = (
                self._max_or_set(
                    constraints.side_setback_left,
                    side,
                )
            )

            constraints.side_setback_right = (
                self._max_or_set(
                    constraints.side_setback_right,
                    side,
                )
            )

        if left is not None:
            constraints.side_setback_left = (
                self._max_or_set(
                    constraints.side_setback_left,
                    left,
                )
            )

        if right is not None:
            constraints.side_setback_right = (
                self._max_or_set(
                    constraints.side_setback_right,
                    right,
                )
            )

        if coverage is not None:
            constraints.maximum_ground_coverage = (
                self._min_or_set(
                    constraints.maximum_ground_coverage,
                    coverage,
                )
            )

        if open_space is not None:
            constraints.minimum_open_space = (
                self._max_or_set(
                    constraints.minimum_open_space,
                    open_space,
                )
            )

    # ======================================================
    # HEIGHT
    # ======================================================

    def _apply_height(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        height = self._number_value(
            result,
            "maximum_height_m",
            "maximum_height",
            "max_height",
            "height_limit",
            "heightLimit",
            "permissible_height",
            "maximumBuildingHeight",
            "heightLimit",
            "height_limit",
        )

        storeys = self._integer_value(
            result,
            "maximum_storeys",
            "max_storeys",
            "permissible_storeys",
            "storeys",
            "floors",
        )

        if height is not None:
            constraints.maximum_height_m = (
                self._min_or_set(
                    constraints.maximum_height_m,
                    height,
                )
            )

        if storeys is not None:
            constraints.maximum_storeys = (
                self._min_int_or_set(
                    constraints.maximum_storeys,
                    storeys,
                )
            )

    # ======================================================
    # PARKING
    # ======================================================

    def _apply_parking(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        car = self._number_value(
            result,
            "car_parking_required",
            "carParkingRequired",
            "car_parking",
            "cars",
        )

        two_wheeler = self._number_value(
            result,
            "two_wheeler_parking_required",
            "twoWheelerParkingRequired",
            "two_wheeler_parking",
            "motorcycle_parking",
        )

        visitor = self._number_value(
            result,
            "visitor_parking_required",
            "visitorParkingRequired",
            "visitor_parking",
        )

        area = self._number_value(
            result,
            "parking_area_required",
            "parkingAreaRequired",
            "parking_area",
        )

        # Some rules express a concrete parking quantity as an action rather
        # than a dedicated field.  Only map it when the resource explicitly
        # identifies car/two-wheeler parking.
        quantity = self._number_value(result, "quantity", "count")
        resource = str(result.get("resource", "")).strip().lower()
        action = str(result.get("action", "")).strip().lower()
        if quantity is not None and action in {"provide", "require", "calculate"}:
            if "two-wheeler" in resource or "two wheeler" in resource or "motorcycle" in resource:
                two_wheeler = quantity
            elif "car" in resource or "vehicle" in resource:
                car = quantity

        if car is not None:
            constraints.car_parking_required = (
                self._max_or_set(
                    constraints.car_parking_required,
                    car,
                )
            )

        if two_wheeler is not None:
            constraints.two_wheeler_parking_required = (
                self._max_or_set(
                    constraints.two_wheeler_parking_required,
                    two_wheeler,
                )
            )

        if visitor is not None:
            constraints.visitor_parking_required = (
                self._max_or_set(
                    constraints.visitor_parking_required,
                    visitor,
                )
            )

        if area is not None:
            constraints.parking_area_required = (
                self._max_or_set(
                    constraints.parking_area_required,
                    area,
                )
            )

    # ======================================================
    # FIRE
    # ======================================================

    def _apply_fire(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        fire_access = self._bool_value(
            result,
            "fire_access_required",
            "fireAccessRequired",
            "fire_access",
        )

        fire_lift = self._bool_value(
            result,
            "fire_lift_required",
            "fireLiftRequired",
            "fire_lift",
        )

        fire_stair = self._bool_value(
            result,
            "fire_staircase_required",
            "fireStaircaseRequired",
            "fire_staircase",
            "enclosed_staircase_required",
        )

        exits = self._integer_value(
            result,
            "minimum_exit_count",
            "minimumExitCount",
            "exit_count",
            "number_of_exits",
        )

        exit_width = self._number_value(
            result,
            "minimum_exit_width_m",
            "minimumExitWidth",
            "exit_width",
        )

        action = str(result.get("action", "")).strip().lower()
        component = str(result.get("component", "")).strip().lower()
        if action in {"require_fire_lift", "provide_fire_lift", "require fire lift"}:
            fire_lift = True
        if action in {"require_fire_staircase", "require staircase"} or "fire escape staircase" in component:
            fire_stair = True

        if fire_access is not None:
            constraints.fire_access_required = (
                self._or_bool(
                    constraints.fire_access_required,
                    fire_access,
                )
            )

        if fire_lift is not None:
            constraints.fire_lift_required = (
                self._or_bool(
                    constraints.fire_lift_required,
                    fire_lift,
                )
            )

        if fire_stair is not None:
            constraints.fire_staircase_required = (
                self._or_bool(
                    constraints.fire_staircase_required,
                    fire_stair,
                )
            )

        if exits is not None:
            constraints.minimum_exit_count = (
                self._max_int_or_set(
                    constraints.minimum_exit_count,
                    exits,
                )
            )

        if exit_width is not None:
            constraints.minimum_exit_width_m = (
                self._max_or_set(
                    constraints.minimum_exit_width_m,
                    exit_width,
                )
            )

    # ======================================================
    # CIRCULATION
    # ======================================================

    def _apply_circulation(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        stairs = self._integer_value(
            result,
            "staircase_count",
            "stair_count",
            "number_of_staircases",
        )

        stair_width = self._number_value(
            result,
            "staircase_width_m",
            "stair_width",
            "minimum_stair_width",
        )

        corridor = self._number_value(
            result,
            "corridor_width_m",
            "corridor_width",
            "minimum_corridor_width",
        )

        lift = self._bool_value(
            result,
            "lift_required",
            "liftRequired",
            "lift",
        )

        lift_count = self._integer_value(
            result,
            "lift_count",
            "number_of_lifts",
        )

        quantity = self._integer_value(result, "quantity", "count")
        action = str(result.get("action", "")).strip().lower()
        component = str(result.get("component", "")).strip().lower()
        if quantity is not None and (
            "stair" in component or "staircase" in component
        ) and action in {"require", "provide"}:
            stairs = quantity

        if stairs is not None:
            constraints.staircase_count = (
                self._max_int_or_set(
                    constraints.staircase_count,
                    stairs,
                )
            )

        if stair_width is not None:
            constraints.staircase_width_m = (
                self._max_or_set(
                    constraints.staircase_width_m,
                    stair_width,
                )
            )

        if corridor is not None:
            constraints.corridor_width_m = (
                self._max_or_set(
                    constraints.corridor_width_m,
                    corridor,
                )
            )

        if lift is not None:
            constraints.lift_required = (
                self._or_bool(
                    constraints.lift_required,
                    lift,
                )
            )

        if lift_count is not None:
            constraints.lift_count = (
                self._max_int_or_set(
                    constraints.lift_count,
                    lift_count,
                )
            )

    # ======================================================
    # ACCESSIBILITY
    # ======================================================

    def _apply_accessibility(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        entrance = self._bool_value(
            result,
            "accessible_entrance_required",
            "accessibleEntranceRequired",
            "accessible_entrance",
        )

        ramp = self._bool_value(
            result,
            "ramp_required",
            "rampRequired",
            "ramp",
        )

        ramp_width = self._number_value(
            result,
            "ramp_width_m",
            "ramp_width",
            "minimum_ramp_width",
        )

        gradient = self._number_value(
            result,
            "ramp_gradient",
            "gradient",
            "maximum_gradient",
        )

        if entrance is not None:
            constraints.accessible_entrance_required = (
                self._or_bool(
                    constraints.accessible_entrance_required,
                    entrance,
                )
            )

        if ramp is not None:
            constraints.ramp_required = (
                self._or_bool(
                    constraints.ramp_required,
                    ramp,
                )
            )

        if ramp_width is not None:
            constraints.ramp_width_m = (
                self._max_or_set(
                    constraints.ramp_width_m,
                    ramp_width,
                )
            )

        if gradient is not None:
            constraints.ramp_gradient = (
                self._min_or_set(
                    constraints.ramp_gradient,
                    gradient,
                )
            )

    # ======================================================
    # OPEN SPACE
    # ======================================================

    def _apply_open_spaces(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        recreational = self._number_value(
            result,
            "recreational_open_space_m2",
            "recreational_open_space",
            "recreation_space",
        )

        amenity = self._number_value(
            result,
            "amenity_space_m2",
            "amenity_space",
        )

        if recreational is not None:
            constraints.recreational_open_space_m2 = (
                self._max_or_set(
                    constraints.recreational_open_space_m2,
                    recreational,
                )
            )

        if amenity is not None:
            constraints.amenity_space_m2 = (
                self._max_or_set(
                    constraints.amenity_space_m2,
                    amenity,
                )
            )

    # ======================================================
    # SPECIAL CONDITIONS
    # ======================================================

    def _apply_special_conditions(
        self,
        constraints: PlanningConstraints,
        category: str,
        name: str,
        result: dict[str, Any],
    ) -> None:

        road_widening = self._bool_value(
            result,
            "road_widening",
            "roadWidening",
            "road_widening_required",
        )

        reservation = self._bool_value(
            result,
            "reservation_present",
            "reservationPresent",
            "reservation",
        )

        special_height = self._number_value(
            result,
            "special_height_limit_m",
            "special_height_limit",
            "height_limit",
        )

        if road_widening is not None:
            constraints.road_widening = (
                self._or_bool(
                    constraints.road_widening,
                    road_widening,
                )
            )

        if reservation is not None:
            constraints.reservation_present = (
                self._or_bool(
                    constraints.reservation_present,
                    reservation,
                )
            )

        if special_height is not None:
            constraints.special_height_limit_m = (
                self._min_or_set(
                    constraints.special_height_limit_m,
                    special_height,
                )
            )

    # ======================================================
    # DERIVED FSI
    # ======================================================

    def _extract_regulatory_requirements(
        self,
        constraints: PlanningConstraints,
        rules: list[ApplicableRule],
    ) -> None:
        """
        Preserve deterministic, directly stated regulatory requirements in the
        existing PlanningConstraints object. This does not invent values and
        does not create a new engine.
        """
        for rule in rules:
            if getattr(rule, "status", None) != "applicable":
                continue

            result = getattr(rule, "result", None)
            if not isinstance(result, dict):
                continue

            name = str(getattr(rule, "name", "")).lower()
            category = str(getattr(rule, "category", "")).lower()

            # Existing unconditional stilt requirement.
            stilt = result.get("minimum_stilt_height")
            if isinstance(stilt, dict):
                value = self._number_value(stilt)
                if value is not None:
                    constraints.metadata["minimum_stilt_height_m"] = value

            # Existing light/ventilation requirement.
            opening = result.get("opening_area")
            if opening is not None:
                constraints.metadata["minimum_opening_area_requirement"] = opening

            if "opening" in result and "ventilation" in (name + category):
                constraints.metadata["light_ventilation_requirement"] = result

            # Preserve explicit table-driven parking instructions.
            if category == "parking" or "parking" in name:
                if result.get("input_tables"):
                    constraints.metadata.setdefault(
                        "parking_rule_references", []
                    ).append({
                        "rule": getattr(rule, "name", None),
                        "tables": result["input_tables"],
                    })
                if result.get("action") in {
                    "calculate",
                    "provide_parking_spaces",
                    "require_off_street_parking",
                }:
                    constraints.metadata.setdefault(
                        "parking_requirements", []
                    ).append({
                        "rule": getattr(rule, "name", None),
                        "result": result,
                    })

            # Preserve fire/stair/egress requirements without pretending
            # conditional thresholds have been satisfied.
            if category in {
                "fire safety",
                "staircase",
                "egress",
                "exit requirements",
            }:
                constraints.metadata.setdefault(
                    "life_safety_requirements", []
                ).append({
                    "rule": getattr(rule, "name", None),
                    "category": getattr(rule, "category", None),
                    "result": result,
                })

    def _calculate_fsi(
        self,
        facts: PlanningFacts,
        constraints: PlanningConstraints,
    ) -> None:

        components = [
            value
            for value in (
                constraints.basic_fsi,
                constraints.premium_fsi,
                constraints.tdr_fsi,
                constraints.incentive_fsi,
            )
            if value is not None
        ]

        if components:
            calculated_total = sum(
                components
            )

            if constraints.maximum_fsi is not None:
                calculated_total = min(
                    calculated_total,
                    constraints.maximum_fsi,
                )

            constraints.total_fsi = (
                calculated_total
            )

        # A maximum FSI is only a regulatory ceiling.  It must never
        # become the achieved/permissible FSI by itself.  Additional FSI
        # must come from an applicable rule result.

    # ======================================================
    # BUILT-UP AREA
    # ======================================================

    def _calculate_built_up_area(
        self,
        facts: PlanningFacts,
        constraints: PlanningConstraints,
    ) -> None:

        if facts.plot_area is None:
            return

        if constraints.total_fsi is None:
            return

        constraints.maximum_built_up_area = (
            facts.plot_area
            * constraints.total_fsi
        )

    # ======================================================
    # HEIGHT
    # ======================================================

    def _calculate_height(
        self,
        facts: PlanningFacts,
        constraints: PlanningConstraints,
    ) -> None:

        # A special height restriction is another
        # upper bound, never an override.
        if (
            constraints.special_height_limit_m
            is not None
        ):
            constraints.maximum_height_m = (
                self._min_or_set(
                    constraints.maximum_height_m,
                    constraints.special_height_limit_m,
                )
            )

        # If a rule provides storeys and a floor height
        # is available, derive a physical height.
        if (
            constraints.maximum_storeys is not None
            and facts.floor_height is not None
        ):
            calculated_height = (
                constraints.maximum_storeys
                * facts.floor_height
            )

            constraints.maximum_height_m = (
                self._min_or_set(
                    constraints.maximum_height_m,
                    calculated_height,
                )
            )

    # ======================================================
    # VALUE HELPERS
    # ======================================================

    @staticmethod
    def _number_value(
        result: dict[str, Any],
        *keys: str,
    ) -> float | None:
        """Read a numeric regulatory value without inventing units.

        UDCPR result_json contains direct numbers, structured values and
        strings such as ``1800mm`` or ``7.5 m``.  This helper normalizes
        common metric length strings to metres while leaving ratios such
        as ``1:12`` untouched.
        """
        import re

        def convert(value: Any) -> float | None:
            if isinstance(value, bool) or value is None:
                return None
            if isinstance(value, (int, float)):
                return float(value)
            if isinstance(value, dict):
                for nested_key in (
                    "value", "amount", "quantity", "meters",
                    "metres", "distance_meters", "distance",
                ):
                    if nested_key in value:
                        converted = convert(value[nested_key])
                        if converted is not None:
                            unit = str(value.get("unit", "")).strip().lower()
                            if unit in {"mm", "millimeter", "millimeters"}:
                                return converted / 1000.0
                            if unit in {"cm", "centimeter", "centimeters"}:
                                return converted / 100.0
                            if unit in {"ft", "feet", "foot"}:
                                return converted * 0.3048
                            if unit in {"in", "inch", "inches"}:
                                return converted * 0.0254
                            return converted
                return None
            text = str(value).strip().lower()
            if ":" in text:
                return None
            match = re.fullmatch(r"([-+]?\d+(?:\.\d+)?)\s*(mm|cm|m|ft|feet|foot|in|inch|inches)?", text)
            if not match:
                return None
            number = float(match.group(1))
            unit = match.group(2) or ""
            if unit == "mm":
                return number / 1000.0
            if unit == "cm":
                return number / 100.0
            if unit in {"ft", "feet", "foot"}:
                return number * 0.3048
            if unit in {"in", "inch", "inches"}:
                return number * 0.0254
            return number

        for key in keys:
            if key in result:
                converted = convert(result[key])
                if converted is not None:
                    return converted
        return None

    @staticmethod
    def _integer_value(
        result: dict[str, Any],
        *keys: str,
    ) -> int | None:

        for key in keys:
            value = result.get(key)

            if value is None:
                continue

            try:
                return int(value)
            except (
                TypeError,
                ValueError,
            ):
                continue

        return None

    @staticmethod
    def _bool_value(
        result: dict[str, Any],
        *keys: str,
    ) -> bool | None:

        for key in keys:
            if key not in result:
                continue

            value = result[key]

            if isinstance(value, bool):
                return value

            if isinstance(value, str):
                normalized = value.strip().lower()

                if normalized in {
                    "true",
                    "yes",
                    "required",
                    "allowed",
                    "permitted",
                }:
                    return True

                if normalized in {
                    "false",
                    "no",
                    "not_required",
                    "prohibited",
                    "not_allowed",
                }:
                    return False

        return None

    @staticmethod
    def _list_value(
        result: dict[str, Any],
        *keys: str,
    ) -> list[Any]:

        for key in keys:
            value = result.get(key)

            if isinstance(value, list):
                return value

        return []

    @staticmethod
    def _max_or_set(
        current: float | None,
        value: float,
    ) -> float:

        if current is None:
            return value

        return max(
            current,
            value,
        )

    @staticmethod
    def _min_or_set(
        current: float | None,
        value: float,
    ) -> float:

        if current is None:
            return value

        return min(
            current,
            value,
        )

    @staticmethod
    def _max_int_or_set(
        current: int | None,
        value: int,
    ) -> int:

        if current is None:
            return value

        return max(
            current,
            value,
        )

    @staticmethod
    def _min_int_or_set(
        current: int | None,
        value: int,
    ) -> int:

        if current is None:
            return value

        return min(
            current,
            value,
        )

    @staticmethod
    def _or_bool(
        current: bool | None,
        value: bool,
    ) -> bool:

        if current is None:
            return value

        return current or value